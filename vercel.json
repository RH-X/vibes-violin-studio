{
  "framework": "astro",
  "redirects": [
    {
      "source": "/creative-mornings-kickstart",
      "destination": "/violin-kickstart",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "vibesviolinstudio.vercel.app" }],
      "destination": "https://www.vibesviolin.studio/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "vibesviolinstudio.vercel.app" }],
      "destination": "https://www.vibesviolin.studio/:path*",
      "permanent": true
    }
  ]
}
