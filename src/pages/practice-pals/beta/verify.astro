---
export const prerender = false;
// This page just proxies the token verification to the API endpoint and redirects.
// All logic lives in /api/beta-verify.ts — this page exists so the email link
// goes to a clean URL (/practice-pals/beta/verify?token=...) rather than /api/...

const token = Astro.url.searchParams.get('token') ?? '';
return Astro.redirect(`/api/beta-verify?token=${encodeURIComponent(token)}`);
---
