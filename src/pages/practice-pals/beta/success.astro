---
import Layout from '../../../layouts/Layout.astro';
---

<Layout
  title="You're on the List — Practice Pals | Vibrations Violin Studio"
  description="Your email is confirmed. You're on the Practice Pals beta interest list."
  noindex={true}
>

  <section
    class="hero-interior"
    style="background: linear-gradient(135deg, #6ee7b7 0%, #c4b5fd 100%);"
    aria-labelledby="success-heading"
  >
    <div class="container-narrow">
      <p class="font-heading font-semibold text-xs uppercase tracking-widest mb-3 text-purplePrimary" style="letter-spacing: 0.14em;">You're in</p>
      <h1 id="success-heading" class="font-heading font-bold text-ink" style="font-size: clamp(2.25rem, 5vw, 4rem); line-height: 0.95; letter-spacing: -0.04em;">
        Email confirmed
      </h1>
      <p class="mt-4 text-lg text-ink/70 leading-relaxed max-w-xl">
        You're on the Practice Pals beta interest list. I'll be in touch when things are ready.
      </p>
    </div>
  </section>

  <section class="section-pad" style="background: #f5f3ff;">
    <div class="container-narrow">
      <div class="max-w-md mx-auto">
        <div class="rounded-2xl border border-lavender-200 bg-white p-8 shadow-sm text-center">

          <!-- Icon -->
          <div class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-mint-100 border border-mint-200 mb-6" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
          </div>

          <h2 class="font-heading font-bold text-ink mb-3" style="font-size: 1.3rem; letter-spacing: -0.02em;">Welcome aboard</h2>
          <p class="text-sm text-ink/60 leading-relaxed">
            Thank you for your interest in Practice Pals. No action needed — I'll reach out directly when beta testing is ready. In the meantime, feel free to explore the rest of the site.
          </p>

          <div class="mt-7 flex flex-col sm:flex-row gap-3 justify-center">
            <a href="/practice-pals" class="btn-secondary text-sm">Back to Practice Pals</a>
            <a href="/" class="btn-secondary text-sm">Go to Home</a>
          </div>

        </div>
      </div>
    </div>
  </section>

</Layout>
