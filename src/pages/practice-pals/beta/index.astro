---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import InquiryEngine from '../../../components/InquiryEngine.astro';
import { practicePalsConfig } from '../../../lib/inquiries/practice-pals';

const error = Astro.url.searchParams.get('error');
---

<Layout
  title="Join the Practice Pals Beta Interest List | Vibrations Violin Studio"
  description="Sign up to hear when Practice Pals beta testing opens. A practice support tool for beginner violin students, built by a real violin teacher."
  noindex={true}
>

  <!-- Hero -->
  <section
    class="hero-interior"
    style="background: linear-gradient(135deg, #6ee7b7 0%, #c4b5fd 100%);"
    aria-labelledby="beta-heading"
  >
    <div class="container-narrow">
      <p class="font-heading font-semibold text-xs uppercase tracking-widest mb-3 text-purplePrimary" style="letter-spacing: 0.14em;">Early Access</p>
      <h1 id="beta-heading" class="font-heading font-bold text-ink" style="font-size: clamp(2.25rem, 5vw, 4rem); line-height: 0.95; letter-spacing: -0.04em;">
        Join the Practice Pals<br/>Beta Interest List
      </h1>
      <p class="mt-4 text-lg text-ink/70 leading-relaxed max-w-xl">
        Practice Pals is still being built. Sign up to be among the first to hear when beta testing opens.
      </p>
    </div>
  </section>

  <!-- Form section -->
  <section class="section-pad" style="background: #f5f3ff;" aria-labelledby="form-heading">
    <div class="container-narrow">
      <div class="max-w-xl mx-auto">

        <!-- Intro -->
        <div class="mb-8">
          <p class="font-heading font-semibold text-xs uppercase tracking-widest text-purplePrimary mb-3" style="letter-spacing: 0.14em;">{practicePalsConfig.intro.label}</p>
          <h2 id="form-heading" class="font-heading font-bold text-ink" style="font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.0; letter-spacing: -0.035em;">
            {practicePalsConfig.intro.heading}
          </h2>
          <div class="mt-4 space-y-3 text-base text-ink/70 font-light leading-relaxed">
            {practicePalsConfig.intro.paragraphs.map((p) => <p>{p}</p>)}
          </div>
        </div>

        <InquiryEngine config={practicePalsConfig} error={error} />

        <!-- Back link -->
        <p class="mt-6 text-center text-sm text-ink/50">
          <a href="/practice-pals" class="text-purplePrimary hover:text-purple-800 transition-colors duration-150">
            ← Back to Practice Pals
          </a>
        </p>

      </div>
    </div>
  </section>

</Layout>
