---
import Layout from '../layouts/Layout.astro';
import CTABand from '../components/CTABand.astro';
---

<Layout
  title="About Rae McGee | Denver Violin Teacher"
  description="Meet Rae McGee, a Denver violin teacher offering warm, Suzuki-informed lessons for children, adults, beginners, and returning players."
>
  <!-- Page header -->
  <section
    class="hero-interior"
    style="background: linear-gradient(135deg, #6ee7b7 0%, #c4b5fd 100%);"
    aria-labelledby="about-heading"
  >
    <div class="container-narrow">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">

        <!-- Left: text block -->
        <div>
          <p class="font-heading font-semibold text-xs uppercase tracking-widest text-purplePrimary mb-3" style="letter-spacing: 0.14em;">About</p>
          <h1 id="about-heading" class="font-heading font-bold text-ink" style="font-size: clamp(2.75rem, 6vw, 5rem); line-height: 0.93; letter-spacing: -0.045em;">
            Meet Rae
          </h1>
          <p class="mt-4 text-lg text-ink/70 leading-relaxed">
            Suzuki-trained violin instructor &amp; founder of Vibrations Violin Studio in Denver, CO.
          </p>
        </div>

        <!-- Right: Rae's photo -->
        <div class="flex justify-center lg:justify-end">
          <img
            src="/images/rae-mktg-site.png"
            alt="Violin instructor Rae holding violin"
            class="w-72 sm:w-80 lg:w-96 h-auto rounded-lg shadow-xl"
            width="1242"
            height="1746"
            loading="eager"
          />
        </div>

      </div>
    </div>
  </section>

  <!-- Bio content -->
  <section class="bg-white section-pad">
    <div class="container-narrow max-w-3xl">
      <h2 class="font-heading font-bold text-ink" style="font-size: clamp(1.25rem, 2.5vw, 1.75rem); line-height: 1.1; letter-spacing: -0.025em;">
        Private violin lessons in Denver, Colorado for children, teens, and adults. Suzuki-based instruction available for beginner and advancing students.
      </h2>
      <p class="mt-6 text-base text-ink/70 leading-relaxed">
        I'm a Suzuki-trained violin teacher offering private violin lessons in Denver, Colorado, where I work with students of all ages—from young beginners to teens and adults returning to music. For more than twenty years I've taught violin through private studios, school programs, and community music initiatives across central Denver, helping students develop strong technique, musical expression, and confidence as performers. My teaching approach blends Suzuki pedagogy with real performance experience, creating lessons that are structured, encouraging, and adapted to each student's learning style. Students come to my studio for beginner violin lessons, Suzuki violin training, and personalized coaching that supports long-term musical growth. In addition to teaching and performing, I also design accessible software products in the education and learning technology space, where I'm passionate about building tools that help people learn more effectively.
      </p>
    </div>
  </section>

  <!-- ── Pricing Grid ── -->
  <section
    id="rates"
    class="bg-white section-pad"
    aria-labelledby="rates-heading"
  >
    <div class="container-narrow max-w-2xl">

      <p class="font-heading font-semibold text-xs uppercase tracking-widest text-purplePrimary mb-3" style="letter-spacing: 0.14em;">Rates &amp; Lesson Options</p>
      <h2
        id="rates-heading"
        class="font-heading font-bold text-ink"
        style="font-size: clamp(2rem, 4vw, 3.25rem); line-height: 0.96; letter-spacing: -0.04em;"
      >
        Simple, transparent pricing.
      </h2>
      <p class="mt-4 text-base text-[#3A3140] leading-relaxed">
        Choose the lesson length that best fits your age, goals, attention span, and stage of learning.
      </p>
      <p class="mt-3 text-sm text-[#3A3140] leading-relaxed">
        Not sure which lesson length makes sense? You do not need to decide before reaching out.
      </p>

      <ul class="mt-10 border-t border-lavender-200" role="list">

        <li class="border-b border-lavender-200 py-5 flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 sm:gap-6">
          <div>
            <p class="font-heading font-semibold text-ink text-base leading-snug" style="letter-spacing: -0.01em;">20-minute trial / intro lesson</p>
            <p class="text-sm text-[#3A3140] mt-0.5">A chance to meet, connect, and explore your goals.</p>
            <p class="text-sm text-[#3A3140] font-light italic mt-0.5">*Complementary if you decide to book lessons.</p>
          </div>
          <p class="text-base font-medium text-purplePrimary sm:text-right shrink-0">$35.00</p>
        </li>

        <li class="border-b border-lavender-200 py-5 flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 sm:gap-6">
          <div>
            <p class="font-heading font-semibold text-ink text-base leading-snug" style="letter-spacing: -0.01em;">30-minute student instruction</p>
            <p class="text-sm text-[#3A3140] mt-0.5">Recommended for ages 6+.</p>
          </div>
          <p class="text-base font-medium text-purplePrimary sm:text-right shrink-0">$50.00</p>
        </li>

        <li class="border-b border-lavender-200 py-5 flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 sm:gap-6">
          <div>
            <p class="font-heading font-semibold text-ink text-base leading-snug" style="letter-spacing: -0.01em;">45-minute student instruction</p>
            <p class="text-sm text-[#3A3140] mt-0.5">More time for deeper learning and growth.</p>
          </div>
          <p class="text-base font-medium text-purplePrimary sm:text-right shrink-0">$75.00</p>
        </li>

        <li class="border-b border-lavender-200 py-5 flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 sm:gap-6">
          <div>
            <p class="font-heading font-semibold text-ink text-base leading-snug" style="letter-spacing: -0.01em;">60-minute student instruction</p>
            <p class="text-sm text-[#3A3140] mt-0.5">Ideal for advanced students or intensive focus.</p>
          </div>
          <p class="text-base font-medium text-purplePrimary sm:text-right shrink-0">$100.00</p>
        </li>

      </ul>

      <ul class="mt-8 space-y-1.5" role="list" aria-label="Lesson policy notes">
        <li class="text-sm text-[#3A3140] font-light"><span aria-hidden="true">· </span>All lessons are private, one-on-one, and offered weekly.</li>
        <li class="text-sm text-[#3A3140] font-light"><span aria-hidden="true">· </span>Payment is due monthly. Scholarships considered.</li>
        <li class="text-sm text-[#3A3140] font-light"><span aria-hidden="true">· </span>Group rates available on request.</li>
      </ul>

      <div class="mt-12 pt-8 border-t border-lavender-200">
        <p class="font-heading font-semibold text-xs uppercase tracking-widest text-purplePrimary mb-3" style="letter-spacing: 0.14em;">Questions Are Welcome</p>
        <h3 class="font-heading font-bold text-ink text-xl sm:text-2xl leading-snug" style="letter-spacing: -0.02em;">
          Let's find the right starting point.
        </h3>
        <p class="mt-3 text-base text-[#3A3140] leading-relaxed">
          You're welcome to ask about lesson length, scheduling, instruments, online or in-person lessons, or what beginning violin might look like for you or your child.
        </p>
        <p class="mt-3 text-sm text-[#3A3140] leading-relaxed">
          The free 15-minute intro chat is simply a low-pressure place to ask questions and see whether the studio feels like a good fit.
        </p>
        <a href="/contact" class="inline-block mt-5 text-sm font-medium text-purplePrimary underline underline-offset-4 decoration-lavender-400 transition-all duration-200 hover:text-purple-800 hover:decoration-purple-800 hover:translate-x-1">
          Ask a question or get started →
        </a>
      </div>

    </div>
  </section>

  <CTABand />
</Layout>

<script>
  // ── About page: scroll-reveal ──
  // Hero: animate heading block on load
  const heroSection = document.querySelector('section[aria-labelledby="about-heading"]');
  if (heroSection) {
    const textBlock = heroSection.querySelector('.grid > div:first-child');
    const photoBlock = heroSection.querySelector('.grid > div:last-child');
    if (textBlock) { textBlock.classList.add('hero-animate', 'hero-delay-1'); }
    if (photoBlock) { photoBlock.classList.add('hero-animate', 'hero-delay-2'); }
  }

  // Body sections: reveal on scroll
  const bioSection = document.querySelector('section.bg-white.section-pad:not(#rates)');
  if (bioSection) bioSection.classList.add('reveal');

  const ratesSection = document.querySelector('section#rates .container-narrow');
  if (ratesSection) ratesSection.classList.add('reveal');

  const ctaBand = document.querySelector('section[aria-labelledby="cta-heading"] .container-narrow');
  if (ctaBand) ctaBand.classList.add('reveal');

  // IntersectionObserver
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
  }
</script>
