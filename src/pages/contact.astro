<style>
  /* ── Expanded panel image column ── */
  .panel-image-col {
    /* Mobile: fixed height so absolute-positioned img has something to fill */
    height: 220px;
  }
  @media (min-width: 768px) {
    .panel-image-col {
      /* Desktop: stretch to fill the full grid row height */
      height: auto;
      min-height: 260px;
    }
  }

  /* ── Fit cards: lift + shadow on hover, matching home page approach cards ── */
  .fit-card {
    transition:
      transform 300ms ease,
      box-shadow 300ms ease,
      border-color 200ms ease,
      background-color 200ms ease;
  }
  .fit-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(109, 40, 217, 0.10);
  }

  @media (prefers-reduced-motion: reduce) {
    .fit-card {
      transition: border-color 200ms ease, background-color 200ms ease;
    }
    .fit-card:hover {
      transform: none;
      box-shadow: none;
    }
  }

  /* Paper airplane: always occupies its 15px width so button never resizes.
     Invisible at rest, fades in on hover. */
  .submit-plane {
    opacity: 0;
    transition: opacity 200ms ease;
  }
  #submit-btn:hover .submit-plane,
  #submit-btn:focus-visible .submit-plane {
    opacity: 1;
  }

  /* Fly-off: diagonal up-right with fade */
  @keyframes plane-fly-off {
    0%   { opacity: 1; transform: translate(0, 0) rotate(0deg); }
    100% { opacity: 0; transform: translate(18px, -16px) rotate(-20deg); }
  }
  .submit-plane-flying {
    animation: plane-fly-off 420ms cubic-bezier(.4, 0, .6, 1) forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .submit-plane { transition: none; }
    .submit-plane-flying { animation: none; opacity: 0; }
  }
</style>

<script>
  // ── Contact page: hero animate ──
  const heroSection = document.querySelector('section[aria-labelledby="contact-heading"]');
  if (heroSection) {
    const inner = heroSection.querySelector('.container-narrow');
    if (inner) inner.classList.add('hero-animate', 'hero-delay-1');
  }

  // ── Scroll-reveal ──
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) { entry.target.classList.add('visible'); observer.unobserve(entry.target); }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
  } else {
    // Reduced motion: immediately show all reveal elements
    document.querySelectorAll('.reveal').forEach(el => el.classList.add('visible'));
  }

  // ── Fit Finder: pathway card open/close ──
  const cards = document.querySelectorAll<HTMLButtonElement>('.fit-card');
  const panels = document.querySelectorAll<HTMLElement>('.pathway-panel');
  const inquiryEngineEl = document.getElementById('inquiry-engine');

  function showInquiryEngine() {
    inquiryEngineEl?.classList.remove('hidden');
    inquiryEngineEl?.classList.add('visible');
  }
  function hideInquiryEngine() {
    inquiryEngineEl?.classList.add('hidden');
  }

  function openPanel(pathwayId: string) {
    // Close all panels and reset all cards first
    panels.forEach(p => p.classList.add('hidden'));
    cards.forEach(c => {
      c.setAttribute('aria-expanded', 'false');
      c.classList.remove('border-purplePrimary', 'bg-white', 'shadow-card');
    });

    // Open the selected panel
    const panel = document.getElementById(`pathway-${pathwayId}`);
    const card = document.querySelector<HTMLButtonElement>(`.fit-card[data-pathway="${pathwayId}"]`);

    if (panel) {
      panel.classList.remove('hidden');
      // Scroll panel into view smoothly
      setTimeout(() => {
        panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }, 50);
    }
    if (card) {
      card.setAttribute('aria-expanded', 'true');
      card.classList.add('border-purplePrimary', 'bg-white', 'shadow-card');
    }
    showInquiryEngine();
  }

  function closePanel(pathwayId: string) {
    const panel = document.getElementById(`pathway-${pathwayId}`);
    const card = document.querySelector<HTMLButtonElement>(`.fit-card[data-pathway="${pathwayId}"]`);
    if (panel) panel.classList.add('hidden');
    if (card) {
      card.setAttribute('aria-expanded', 'false');
      card.classList.remove('border-purplePrimary', 'bg-white', 'shadow-card');
    }
    hideInquiryEngine();
  }

  // If we were redirected back here with an error (e.g. #inquiry-engine?error=...),
  // keep the engine visible even though no pathway card is selected.
  if (new URLSearchParams(window.location.search).has('error')) {
    showInquiryEngine();
  }

  // Card click handlers
  cards.forEach(card => {
    card.addEventListener('click', () => {
      const pathway = card.getAttribute('data-pathway');
      if (!pathway) return;
      // Toggle: if already open, close it
      const isExpanded = card.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        closePanel(pathway);
      } else {
        openPanel(pathway);
      }
    });
  });

  // Close button handlers
  document.querySelectorAll<HTMLButtonElement>('.pathway-close').forEach(btn => {
    btn.addEventListener('click', () => {
      const pathway = btn.getAttribute('data-close');
      if (pathway) closePanel(pathway);
    });
  });

  // ── Email copy button ──
  document.querySelectorAll('.copy-email').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const email = btn.getAttribute('data-copy');
      if (!email) return;
      const textEl = btn.querySelector('.copy-email-text') || btn;
      const original = textEl.textContent;
      let success = false;
      try {
        await navigator.clipboard.writeText(email);
        success = true;
      } catch {
        try {
          const ta = document.createElement('textarea');
          ta.value = email;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          document.body.removeChild(ta);
          success = true;
        } catch { /* ignore */ }
      }
      if (success) {
        textEl.textContent = '✓ Copied!';
        (textEl as HTMLElement).classList.add('text-green-600');
      } else {
        textEl.textContent = 'Copy failed';
        (textEl as HTMLElement).classList.add('text-red-500');
      }
      setTimeout(() => {
        textEl.textContent = original;
        (textEl as HTMLElement).classList.remove('text-green-600', 'text-red-500');
      }, 2000);
    });
  });

  // ── Submit button: fly-off microinteraction + Web3Forms fetch ──
  // TEMPORARILY REMOVED — form is offline. Restore this section with the form HTML.
</script>
