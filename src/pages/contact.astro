---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Get Started — Vibrations Violin Studio | Denver, CO"
  description="Book a free 15-minute intro chat with Rae to explore violin lessons in Denver, CO. No pressure — just a friendly conversation."
>

  <!-- Hero banner — matches site gradient direction -->
  <section
    class="hero-interior relative overflow-hidden"
    style="background: linear-gradient(135deg, #fb923c 0%, #c4b5fd 100%);"
    aria-labelledby="contact-heading"
  >
    <!-- Ambient blob -->
    <div class="pointer-events-none absolute -top-20 -right-20 w-80 h-80 rounded-full bg-lavender-300 opacity-30 blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -bottom-16 -left-16 w-64 h-64 rounded-full" style="background:#fbd0b0; opacity:0.35; filter:blur(48px);" aria-hidden="true"></div>

    <div class="container-narrow">
      <div class="max-w-2xl">
        <p class="font-heading font-semibold text-xs uppercase tracking-widest text-purplePrimary mb-3" style="letter-spacing: 0.14em;">Get Started</p>
        <h1
          id="contact-heading"
          class="font-heading font-bold text-ink"
          style="font-size: clamp(2.75rem, 6vw, 5rem); line-height: 0.93; letter-spacing: -0.045em;"
        >
          Let's Chat
        </h1>
        <p class="mt-4 text-lg leading-relaxed" style="color: #2F2A35; max-width: 38rem;">
          Let's say hello 👋 — Book a friendly 15-minute intro chat with Rae to explore whether violin lessons might be something you'd like to try.
        </p>
      </div>
    </div>
  </section>

  <!-- Form section — editorial two-zone layout -->
  <section
    class="section-pad relative overflow-hidden bg-white"
    id="get-started"
  >

    <!-- Soft lavender blob — upper right, behind layout -->
    <div
      class="pointer-events-none absolute"
      style="
        width: 480px; height: 480px;
        top: -80px; right: -100px;
        background: #c4b5fd;
        opacity: 0.18;
        border-radius: 58% 42% 48% 52% / 44% 56% 44% 56%;
      "
      aria-hidden="true"
    ></div>

    <!-- Single squiggle accent — lower left -->
    <svg
      class="pointer-events-none absolute hidden lg:block"
      style="width: 80px; height: 50px; bottom: 40px; left: 28px; opacity: 0.3;"
      viewBox="0 0 80 48"
      fill="none"
      stroke="#5b21b6"
      stroke-width="1.6"
      stroke-linecap="round"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M4 24 C16 6, 28 42, 40 24 C52 6, 64 42, 76 24" />
    </svg>

    <div class="container-narrow relative">

      <!-- Two-zone grid: form left-center, contact sidebar right -->
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_300px] gap-12 lg:gap-16 items-start">

        <!-- ── Left: form zone ── -->
        <div>
          <div class="mb-8">
            <h2
              class="font-heading font-bold text-ink"
              style="font-size: clamp(1.6rem, 3vw, 2.25rem); line-height: 1.0; letter-spacing: -0.035em;"
            >
              Book a call, or just say hello.
            </h2>
            <p class="mt-3 text-base leading-relaxed" style="color: #3A3140;">
              Whether you're ready to get started or still have questions — this is the right place. Rae reads every message and will reach out personally.
            </p>
          </div>

          <form
            method="POST"
            class="flex flex-col gap-6"
            aria-label="Contact form"
          >

            <div class="flex flex-col gap-1.5">
              <label for="name" class="text-sm font-semibold text-ink" style="letter-spacing: 0.01em;">Your name</label>
              <input
                id="name"
                name="name"
                type="text"
                autocomplete="name"
                required
                placeholder="Jane Smith"
                class="w-full px-4 py-3 rounded-xl border border-lavender-200 bg-lavender-50/60 text-ink text-sm
                       placeholder-ink/30 focus:outline-none focus:ring-2 focus:ring-purplePrimary focus:border-transparent focus:bg-white transition-colors duration-150"
              />
            </div>

            <div class="flex flex-col gap-1.5">
              <label for="email" class="text-sm font-semibold text-ink" style="letter-spacing: 0.01em;">Email address</label>
              <input
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                required
                placeholder="jane@example.com"
                class="w-full px-4 py-3 rounded-xl border border-lavender-200 bg-lavender-50/60 text-ink text-sm
                       placeholder-ink/30 focus:outline-none focus:ring-2 focus:ring-purplePrimary focus:border-transparent focus:bg-white transition-colors duration-150"
              />
            </div>

            <div class="flex flex-col gap-1.5">
              <label for="message" class="text-sm font-semibold text-ink" style="letter-spacing: 0.01em;">
                Anything you'd like Rae to know? <span class="text-ink/40 font-normal">(optional)</span>
              </label>
              <textarea
                id="message"
                name="message"
                rows="5"
                placeholder="My 7-year-old has been asking about violin lessons..."
                class="w-full px-4 py-3 rounded-xl border border-lavender-200 bg-lavender-50/60 text-ink text-sm
                       placeholder-ink/30 focus:outline-none focus:ring-2 focus:ring-purplePrimary focus:border-transparent focus:bg-white transition-colors duration-150 resize-none"
              ></textarea>
            </div>

            <div class="flex flex-col items-center gap-2 pt-1">
              <button type="submit" class="btn-primary text-base px-8 py-3.5" style="width: fit-content; align-self: center;">
                Send Message
              </button>
              <p class="text-xs text-center leading-relaxed" style="color: #5a5060;">
                No spam, ever. Rae typically replies within one business day.
              </p>
            </div>

          </form>
        </div>

        <!-- ── Right: contact sidebar ── -->
        <div class="lg:pt-2">
          <div
            class="rounded-2xl p-6 flex flex-col gap-5"
            style="background: #f5f3ff; border: 1px solid #e9d5ff;"
          >
            <p class="font-heading font-semibold text-xs uppercase tracking-widest text-purplePrimary" style="letter-spacing: 0.14em;">Prefer direct contact?</p>

            <!-- Email copy -->
            <div class="flex flex-col gap-1">
              <p class="text-xs font-semibold text-ink/50 uppercase tracking-wide" style="font-size: 0.7rem; letter-spacing: 0.1em;">Email</p>
              <button
                class="copy-email inline-flex items-center gap-2 text-sm font-medium text-purplePrimary hover:text-purple-800 transition-colors duration-150 cursor-pointer bg-transparent border-none p-0 text-left focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purplePrimary"
                data-copy="vibesviolinstudio@gmail.com"
                type="button"
                aria-label="Copy email address to clipboard"
              >
                <svg class="flex-shrink-0" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                <span class="copy-email-text">vibesviolinstudio@gmail.com</span>
              </button>
            </div>

            <div class="w-full h-px bg-lavender-200" aria-hidden="true"></div>

            <!-- Phone -->
            <div class="flex flex-col gap-2">
              <p class="text-xs font-semibold text-ink/50 uppercase tracking-wide" style="font-size: 0.7rem; letter-spacing: 0.1em;">Phone</p>
              <p class="text-sm font-semibold text-ink">(720) 253-0416</p>
              <div class="flex items-center gap-3">
                <a
                  href="tel:+17202530416"
                  class="inline-flex items-center gap-1.5 text-sm font-medium text-purplePrimary hover:text-purple-800 transition-colors duration-150 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purplePrimary"
                  aria-label="Call Vibrations Violin Studio"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                  </svg>
                  Tap to call
                </a>
                <span class="text-lavender-300 text-xs" aria-hidden="true">|</span>
                <a
                  href="sms:+17202530416"
                  class="inline-flex items-center gap-1.5 text-sm font-medium text-purplePrimary hover:text-purple-800 transition-colors duration-150 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purplePrimary"
                  aria-label="Text Vibrations Violin Studio"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
                  </svg>
                  Tap to text
                </a>
              </div>
            </div>

          </div>
        </div>
        <!-- /sidebar -->

      </div>
    </div>
  </section>

</Layout>

<script>
  // ── Contact page: scroll-reveal ──
  const heroSection = document.querySelector('section[aria-labelledby="contact-heading"]');
  if (heroSection) {
    const inner = heroSection.querySelector('.container-narrow');
    if (inner) inner.classList.add('hero-animate', 'hero-delay-1');
  }

  const formSection = document.querySelector('section#get-started .container-narrow');
  if (formSection) formSection.classList.add('reveal');

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) { entry.target.classList.add('visible'); observer.unobserve(entry.target); }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
  }

  // ── Email copy button ──
  document.querySelectorAll('.copy-email').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const email = btn.getAttribute('data-copy');
      if (!email) return;
      const textEl = btn.querySelector('.copy-email-text') || btn;
      const original = textEl.textContent;
      let success = false;
      try {
        await navigator.clipboard.writeText(email);
        success = true;
      } catch {
        try {
          const ta = document.createElement('textarea');
          ta.value = email;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          document.body.removeChild(ta);
          success = true;
        } catch { /* ignore */ }
      }
      if (success) {
        textEl.textContent = '✓ Copied!';
        textEl.classList.add('text-green-600');
      } else {
        textEl.textContent = 'Copy failed';
        textEl.classList.add('text-red-500');
      }
      setTimeout(() => {
        textEl.textContent = original;
        textEl.classList.remove('text-green-600', 'text-red-500');
      }, 2000);
    });
  });
</script>
