---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Get Started — Vibrations Violin Studio | Denver, CO"
  description="Book a free 15-minute intro chat with Rae to explore violin lessons in Denver, CO. No pressure — just a friendly conversation."
>
  <section
    class="section-pad"
    style="background: linear-gradient(135deg, #fbd0b0 0%, #ddd6fe 100%);"
    aria-labelledby="contact-heading"
  >
    <div class="container-narrow max-w-2xl text-center mx-auto">
      <p class="font-heading font-semibold text-xs uppercase tracking-widest text-purplePrimary mb-3" style="letter-spacing: 0.14em;">Get Started</p>
      <h1 id="contact-heading" class="font-heading font-bold text-ink" style="font-size: clamp(2.75rem, 6vw, 5rem); line-height: 0.93; letter-spacing: -0.045em;">
        Let's Chat
      </h1>
      <p class="mt-4 text-lg text-ink/70 leading-relaxed">
        Let's say hello 👋 — Book a friendly 15-minute intro chat with Rae to explore whether violin lessons might be something you'd like to try.
      </p>
    </div>
  </section>

  <section class="bg-white section-pad" id="get-started">
    <div class="container-narrow max-w-lg mx-auto">

      <div class="mb-8">
        <h2 class="font-heading font-bold text-ink mb-2" style="font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.0; letter-spacing: -0.03em;">
          Book a call, or just say hello.
        </h2>
        <p class="text-base text-ink/70 leading-relaxed">
          Whether you're ready to get started or still have questions — this is the right place. Rae reads every message personally and will reach out personally!
        </p>
      </div>

      <form
        method="POST"
        class="bg-lavender-50 border border-lavender-200 rounded-lg shadow-card p-8 flex flex-col gap-5"
        aria-label="Contact form"
      >
        <div class="flex flex-col gap-1.5">
          <label for="name" class="text-sm font-medium text-ink">Your name</label>
          <input
            id="name"
            name="name"
            type="text"
            autocomplete="name"
            required
            placeholder="Jane Smith"
            class="w-full px-4 py-2.5 rounded-lg border border-lavender-200 bg-white text-ink text-sm
                   placeholder-ink/30 focus:outline-none focus:ring-2 focus:ring-purplePrimary focus:border-transparent"
          />
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="email" class="text-sm font-medium text-ink">Email address</label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            required
            placeholder="jane@example.com"
            class="w-full px-4 py-2.5 rounded-lg border border-lavender-200 bg-white text-ink text-sm
                   placeholder-ink/30 focus:outline-none focus:ring-2 focus:ring-purplePrimary focus:border-transparent"
          />
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="message" class="text-sm font-medium text-ink">Anything you'd like Rae to know? <span class="text-ink/40 font-light">(optional)</span></label>
          <textarea
            id="message"
            name="message"
            rows="4"
            placeholder="My 7-year-old has been asking about violin lessons..."
            class="w-full px-4 py-2.5 rounded-lg border border-lavender-200 bg-white text-ink text-sm
                   placeholder-ink/30 focus:outline-none focus:ring-2 focus:ring-purplePrimary focus:border-transparent resize-none"
          ></textarea>
        </div>

        <button type="submit" class="btn-primary w-full text-center py-3.5 mt-2">
          Send Message
        </button>

        <p class="text-xs text-ink/40 text-center leading-relaxed">
          No spam, ever. Rae typically replies within one business day.
        </p>
      </form>

      <!-- Direct contact fallback -->
      <div class="mt-8">
        <p class="text-sm text-ink/50 font-light text-center mb-4">Prefer email or phone?</p>
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3">

          <!-- Email -->
          <button
            class="copy-email inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-lg border border-lavender-300 bg-lavender-50 px-4 py-3 text-sm font-medium text-purplePrimary hover:bg-lavender-100 transition-colors duration-150 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purplePrimary"
            data-copy="vibesviolinstudio@gmail.com"
            type="button"
            aria-label="Copy email address to clipboard"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <span class="copy-email-text">vibesviolinstudio@gmail.com</span>
          </button>

          <!-- Phone group: number + call + text -->
          <div class="flex items-center justify-center gap-2 rounded-lg border border-lavender-300 bg-lavender-50 px-4 py-3">
            <span class="text-sm font-medium text-ink whitespace-nowrap">(720) 253-0416</span>
            <span class="text-lavender-300" aria-hidden="true">·</span>
            <a
              href="tel:+17202530416"
              class="inline-flex items-center gap-1.5 text-sm font-medium text-purplePrimary hover:text-purple-800 transition-colors duration-150 whitespace-nowrap focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purplePrimary"
              aria-label="Call Vibrations Violin Studio at (720) 253-0416"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              Call
            </a>
            <span class="text-lavender-300" aria-hidden="true">·</span>
            <a
              href="sms:+17202530416"
              class="inline-flex items-center gap-1.5 text-sm font-medium text-purplePrimary hover:text-purple-800 transition-colors duration-150 whitespace-nowrap focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purplePrimary"
              aria-label="Text Vibrations Violin Studio at (720) 253-0416"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
              </svg>
              Text
            </a>
          </div>

        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll('.copy-email').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const email = btn.getAttribute('data-copy');
      if (!email) return;
      const original = btn.textContent;
      let success = false;
      try {
        await navigator.clipboard.writeText(email);
        success = true;
      } catch {
        // Fallback for non-secure contexts
        try {
          const ta = document.createElement('textarea');
          ta.value = email;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          document.body.removeChild(ta);
          success = true;
        } catch { /* ignore */ }
      }
      if (success) {
        btn.textContent = '✓ Copied!';
        btn.classList.remove('text-purplePrimary');
        btn.classList.add('text-green-600');
      } else {
        btn.textContent = 'Copy failed';
        btn.classList.remove('text-purplePrimary');
        btn.classList.add('text-red-500');
      }
      setTimeout(() => {
        btn.textContent = original;
        btn.classList.remove('text-green-600', 'text-red-500');
        btn.classList.add('text-purplePrimary');
      }, 2000);
    });
  });
</script>
