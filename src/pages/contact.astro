---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import InquiryEngine from '../components/InquiryEngine.astro';
import { contactConfig } from '../lib/inquiries/contact';

const error = Astro.url.searchParams.get('error');
---

<Layout
  title="Contact Vibrations Violin Studio | Denver Lessons"
  description="Reach out about supportive violin lessons in Denver or online. Ask questions, share your goals, or start with a low-pressure intro chat."
>

  <!-- Hero banner — matches site gradient direction -->
  <section
    class="hero-interior relative overflow-hidden"
    style="background: linear-gradient(135deg, #fb923c 0%, #c4b5fd 100%);"
    aria-labelledby="contact-heading"
  >
    <!-- Ambient blob -->
    <div class="pointer-events-none absolute -top-20 -right-20 w-80 h-80 rounded-full bg-lavender-300 opacity-30 blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -bottom-16 -left-16 w-64 h-64 rounded-full" style="background:#fbd0b0; opacity:0.35; filter:blur(48px);" aria-hidden="true"></div>

    <div class="container-narrow">
      <div class="max-w-2xl">
        <p class="font-heading font-semibold text-xs uppercase tracking-widest text-purplePrimary mb-3" style="letter-spacing: 0.14em;">Get Started</p>
        <h1
          id="contact-heading"
          class="font-heading font-bold text-ink"
          style="font-size: clamp(2.75rem, 6vw, 5rem); line-height: 0.93; letter-spacing: -0.045em;"
        >
          Get Started
        </h1>
        <p class="mt-4 text-lg leading-relaxed" style="color: #2F2A35; max-width: 38rem;">
          Not sure where to start? Pick the path that fits you best — or scroll down to send a message directly.
        </p>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       NEW STUDENT FIT FINDER
  ══════════════════════════════════════════════ -->
  <section
    class="section-pad relative overflow-hidden bg-white"
    id="fit-finder"
    aria-labelledby="fit-finder-heading"
  >

    <!-- Soft lavender blob — upper right -->
    <div
      class="pointer-events-none absolute"
      style="
        width: 480px; height: 480px;
        top: -80px; right: -100px;
        background: #c4b5fd;
        opacity: 0.13;
        border-radius: 58% 42% 48% 52% / 44% 56% 44% 56%;
      "
      aria-hidden="true"
    ></div>

    <div class="container-narrow relative">

      <!-- Section heading -->
      <div class="max-w-xl mb-10 reveal">
        <p class="font-heading font-semibold text-xs uppercase tracking-widest text-purplePrimary mb-3" style="letter-spacing: 0.14em;">New Student Fit Finder</p>
        <h2
          id="fit-finder-heading"
          class="font-heading font-bold text-ink"
          style="font-size: clamp(1.6rem, 3vw, 2.25rem); line-height: 1.0; letter-spacing: -0.035em;"
        >
          What brings you here?
        </h2>
        <p class="mt-3 text-base leading-relaxed" style="color: #3A3140;">
          Choose the path that feels most like your situation. Each one leads to a short intro chat or message — just a friendly conversation to learn more.
        </p>
      </div>

      <!-- Pathway cards — 3-column on desktop, stacked on mobile -->
      <div
        class="grid grid-cols-1 sm:grid-cols-3 gap-5 reveal"
        role="group"
        aria-label="Choose your learning path"
      >

        <!-- Card: Parents -->
        <button
          class="fit-card group text-left w-full rounded-2xl border border-lavender-200 bg-lavender-50 overflow-hidden flex flex-col gap-0
                 hover:border-lavender-300 hover:bg-lavender-100
                 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purplePrimary
                 transition-colors duration-200"
          data-pathway="parents"
          aria-expanded="false"
          aria-controls="pathway-parents"
          type="button"
        >
          <!--
            PLACEHOLDER IMAGE — parents card
            Replace src with: real studio photo, editorial image, or remove the entire
            <div class="fit-card-image"> block to revert to icon-only layout.
            Suggested final asset: child-sized violin on a music stand, natural light, warm tones.
          -->
          <div class="fit-card-image w-full overflow-hidden flex-shrink-0" style="height: 140px;">
            <img
              src="https://images.pexels.com/photos/8471864/pexels-photo-8471864.jpeg?auto=compress&cs=tinysrgb&w=600"
              alt=""
              aria-hidden="true"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              style="object-position: center 15%;"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="flex flex-col gap-4 p-6 flex-1">
            <!-- Icon -->
            <span class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-white border border-lavender-200 text-purplePrimary flex-shrink-0" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
              </svg>
            </span>

            <div class="flex flex-col gap-1.5 flex-1">
              <h3 class="font-heading font-semibold text-ink" style="font-size: 1.1rem; letter-spacing: -0.01em;">For parents</h3>
              <p class="text-sm leading-relaxed" style="color: #3A3140;">Looking for violin lessons for your child.</p>
            </div>

            <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-purplePrimary group-hover:text-purple-800 transition-colors duration-150">
              Explore this path
              <svg class="transition-transform duration-200 group-hover:translate-x-1" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </span>
          </div>
        </button>

        <!-- Card: Adult Beginners -->
        <button
          class="fit-card group text-left w-full rounded-2xl border border-lavender-200 bg-lavender-50 overflow-hidden flex flex-col gap-0
                 hover:border-lavender-300 hover:bg-lavender-100
                 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purplePrimary
                 transition-colors duration-200"
          data-pathway="adults"
          aria-expanded="false"
          aria-controls="pathway-adults"
          type="button"
        >
          <!--
            PLACEHOLDER IMAGE — adult learners card
            Replace src with: real studio photo, editorial image, or remove the entire
            <div class="fit-card-image"> block to revert to icon-only layout.
            Suggested final asset: adult hands holding a violin bow, natural light, quiet atmosphere.
          -->
          <div class="fit-card-image w-full overflow-hidden flex-shrink-0" style="height: 140px;">
            <img
              src="https://images.unsplash.com/photo-1465847899084-d164df4dedc6?w=600&q=72&auto=format&fit=crop"
              alt=""
              aria-hidden="true"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="flex flex-col gap-4 p-6 flex-1">
            <!-- Icon -->
            <span class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-white border border-lavender-200 text-purplePrimary flex-shrink-0" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 18V5l12-2v13"/>
                <circle cx="6" cy="18" r="3"/>
                <circle cx="18" cy="16" r="3"/>
              </svg>
            </span>

            <div class="flex flex-col gap-1.5 flex-1">
              <h3 class="font-heading font-semibold text-ink" style="font-size: 1.1rem; letter-spacing: -0.01em;">For adult learners</h3>
              <p class="text-sm leading-relaxed" style="color: #3A3140;">Violin has been calling my name.</p>
            </div>

            <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-purplePrimary group-hover:text-purple-800 transition-colors duration-150">
              Explore this path
              <svg class="transition-transform duration-200 group-hover:translate-x-1" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </span>
          </div>
        </button>

        <!-- Card: Online Lessons -->
        <button
          class="fit-card group text-left w-full rounded-2xl border border-lavender-200 bg-lavender-50 overflow-hidden flex flex-col gap-0
                 hover:border-lavender-300 hover:bg-lavender-100
                 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purplePrimary
                 transition-colors duration-200"
          data-pathway="online"
          aria-expanded="false"
          aria-controls="pathway-online"
          type="button"
        >
          <!--
            PLACEHOLDER IMAGE — online lessons card
            Replace src with: real studio photo, editorial image, or remove the entire
            <div class="fit-card-image"> block to revert to icon-only layout.
            Suggested final asset: violin resting near a laptop or music stand by a window, home setting.
          -->
          <div class="fit-card-image w-full overflow-hidden flex-shrink-0" style="height: 140px;">
            <img
              src="https://images.pexels.com/photos/6671395/pexels-photo-6671395.jpeg?auto=compress&cs=tinysrgb&w=600"
              alt=""
              aria-hidden="true"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              style="object-position: center 50%;"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="flex flex-col gap-4 p-6 flex-1">
            <!-- Icon -->
            <span class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-white border border-lavender-200 text-purplePrimary flex-shrink-0" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="2" y1="12" x2="22" y2="12"/>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
              </svg>
            </span>

            <div class="flex flex-col gap-1.5 flex-1">
              <h3 class="font-heading font-semibold text-ink" style="font-size: 1.1rem; letter-spacing: -0.01em;">For online lessons</h3>
              <p class="text-sm leading-relaxed" style="color: #3A3140;">I'm located outside of Denver or prefer online.</p>
            </div>

            <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-purplePrimary group-hover:text-purple-800 transition-colors duration-150">
              Explore this path
              <svg class="transition-transform duration-200 group-hover:translate-x-1" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </span>
          </div>
        </button>

      </div>
      <!-- /cards -->

      <!-- ── Pathway detail panels ── -->

      <!-- Panel: Parents -->
      <div
        id="pathway-parents"
        class="pathway-panel hidden mt-8"
        role="region"
        aria-label="For parents — pathway details"
