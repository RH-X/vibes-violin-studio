---
import Layout from '../layouts/Layout.astro';

const sections = [
  {
    heading: 'Information you share',
    body: 'When you contact me or join a waitlist, I collect the information you provide, such as your name, email, message, or program interests.',
  },
  {
    heading: "How it's used",
    body: "I use your information to respond to inquiries and share updates you've requested. You'll only receive Violin Kickstart marketing emails if you've opted in. I never sell your personal information.",
  },
  {
    heading: 'Website analytics',
    body: 'I use Google Analytics and Microsoft Clarity to understand how visitors use my website and improve their experience. These tools may use cookies or similar technologies.',
  },
  {
    heading: 'Website services',
    body: 'My website uses trusted services for hosting, form storage, email delivery, and security, including Vercel, Supabase, Resend, and Cloudflare Turnstile (spam prevention).',
  },
  {
    heading: 'Your choices',
    body: 'You can request access to, correction of, or deletion of your information, or unsubscribe from emails at any time.',
  },
  {
    heading: "Children's privacy",
    body: 'Website forms are intended for adults. Parents or guardians should submit inquiries on behalf of children.',
  },
];
---

<Layout
  title="Privacy Policy | Vibrations Violin Studio"
  description="How Vibrations Violin Studio collects and uses information through this website."
>
  <section class="bg-white section-pad" aria-labelledby="privacy-heading">
    <div class="container-narrow">
      <div class="max-w-2xl">
        <h1 id="privacy-heading" class="font-heading font-bold text-ink" style="font-size: clamp(1.75rem, 4vw, 2.5rem); line-height: 1.1; letter-spacing: -0.035em;">
          Privacy Policy
        </h1>
        <p class="mt-3 text-sm italic text-ink/70">Last updated November 7, 2026</p>
        <p class="mt-6 text-base text-ink/70 leading-relaxed">
          Your privacy matters to me. Here's how Vibrations Violin Studio handles information shared through this website.
        </p>
        {sections.map(({ heading, body }) => (
          <>
            <h2 class="mt-8 font-heading font-bold text-ink" style="font-size: clamp(1.15rem, 2.2vw, 1.35rem); line-height: 1.2; letter-spacing: -0.02em;">{heading}</h2>
            <p class="mt-3 text-base text-ink/70 leading-relaxed">{body}</p>
          </>
        ))}
        <h2 class="mt-8 font-heading font-bold text-ink" style="font-size: clamp(1.15rem, 2.2vw, 1.35rem); line-height: 1.2; letter-spacing: -0.02em;">Questions?</h2>
        <p class="mt-3 text-base text-ink/70 leading-relaxed">
          Email me at <a href="mailto:vibesviolinstudio@gmail.com" class="font-semibold text-purplePrimary underline hover:text-purple-800 transition-colors duration-150">vibesviolinstudio@gmail.com</a>.
        </p>
      </div>
    </div>
  </section>
</Layout>
