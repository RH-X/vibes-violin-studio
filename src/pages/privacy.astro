---
import Layout from '../layouts/Layout.astro';

const sections = [
  {
    heading: 'What I collect',
    body: "When you fill out a form, I collect what you enter, such as your name, email address, and message or program choice. If you agree to Kickstart emails, I save when you agreed. I also save your IP address with each form submission, to help prevent spam.",
  },
  {
    heading: 'How I use it',
    body: "I use your information to reply to you, confirm your email address, and send the updates you asked for. I only send Kickstart updates if you've agreed to them. I don't sell your personal information.",
  },
  {
    heading: 'Analytics and cookies',
    body: "This site uses Google Analytics and Microsoft Clarity to understand how visitors use it, including pages viewed, clicks, and scrolling. These tools use cookies or similar technology. Names and email addresses from forms aren't sent to Google Analytics.",
  },
  {
    heading: 'Services I use',
    body: "A few providers help run this site: Vercel for hosting, Supabase for storing form submissions, Resend for sending email, Cloudflare Turnstile for spam protection, and Google Fonts for typography.",
  },
  {
    heading: 'Your choices',
    body: "You can ask me to show you, correct, or delete your information, or to stop emailing you, at any time. Just email me and I'll take care of it.",
  },
  {
    heading: 'Children',
    body: 'The forms on this site are meant for adults. If you are looking for lessons for a child, a parent or guardian should get in touch.',
  },
];
---

<Layout
  title="Privacy Policy | Vibrations Violin Studio"
  description="How Vibrations Violin Studio collects and uses information through this website."
>
  <section class="bg-white section-pad" aria-labelledby="privacy-heading">
    <div class="container-narrow">
      <div class="max-w-2xl">
        <h1 id="privacy-heading" class="font-heading font-bold text-ink" style="font-size: clamp(1.75rem, 4vw, 2.5rem); line-height: 1.1; letter-spacing: -0.035em;">
          Privacy Policy
        </h1>
        <p class="mt-3 text-sm text-ink/70">Last updated November 7, 2026</p>
        <p class="mt-6 text-base text-ink/70 leading-relaxed">
          Here's what Vibrations Violin Studio collects through this website, and why.
        </p>
        {sections.map(({ heading, body }) => (
          <>
            <h2 class="mt-8 font-heading font-bold text-ink" style="font-size: clamp(1.15rem, 2.2vw, 1.35rem); line-height: 1.2; letter-spacing: -0.02em;">{heading}</h2>
            <p class="mt-3 text-base text-ink/70 leading-relaxed">{body}</p>
          </>
        ))}
        <h2 class="mt-8 font-heading font-bold text-ink" style="font-size: clamp(1.15rem, 2.2vw, 1.35rem); line-height: 1.2; letter-spacing: -0.02em;">Contact</h2>
        <p class="mt-3 text-base text-ink/70 leading-relaxed">
          Questions or requests: <a href="mailto:vibesviolinstudio@gmail.com" class="text-purplePrimary underline hover:text-purple-800 transition-colors duration-150">vibesviolinstudio@gmail.com</a>
        </p>
      </div>
    </div>
  </section>
</Layout>
