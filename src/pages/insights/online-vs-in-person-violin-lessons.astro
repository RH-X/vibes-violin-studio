              <td class="py-3 text-base text-ink/70 font-light">Easier to guide physically and keep engaged</td>
            </tr>
          </tbody>
        </table>
      </div>

    </div><!-- /max-w-2xl -->
      <!-- Pull quote — breaks out of narrow column -->
