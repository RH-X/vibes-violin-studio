<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "Returning to Violin After Years Away: What to Expect",
  "description": "Thinking about returning to violin as an adult? Learn what to expect, what you may remember, how to restart practice, and why you don't need to start completely over.",
  "image": `${siteOrigin}/images/insights/returning-to-violin-after-years-away.jpg`,
  "datePublished": publishedDate,
  "dateModified": publishedDate,
  "author": { "@id": `${siteOrigin}/#person` },
  "publisher": { "@id": `${siteOrigin}/#business` },
  "mainEntityOfPage": canonicalURL,
  "articleSection": "Adult Violin Lessons",
})} />

<script>
  // ── Article page: scroll-reveal ──
  const heroSection = document.querySelector('section[aria-labelledby="post-heading"]');
  if (heroSection) {
    const inner = heroSection.querySelector('.container-narrow');
    if (inner) inner.classList.add('hero-animate', 'hero-delay-1');
  }

  const articleBody = document.querySelector('article .container-narrow');
  if (articleBody) articleBody.classList.add('reveal');

  const relatedSection = document.querySelector('section[aria-labelledby="related-heading"] .container-narrow');
  if (relatedSection) relatedSection.classList.add('reveal');

  const ctaBand = document.querySelector('section[aria-labelledby="cta-heading"] .container-narrow');
  if (ctaBand) ctaBand.classList.add('reveal');

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) { entry.target.classList.add('visible'); observer.unobserve(entry.target); }
      });
    }, { threshold: 0.08 });
    document.querySelectorAll('.reveal').forEach(el => {
      const rect = el.getBoundingClientRect();
      if (rect.top < window.innerHeight && rect.bottom > 0) {
        el.classList.add('visible');
      } else {
        observer.observe(el);
      }
    });
  } else {
    document.querySelectorAll('.reveal').forEach(el => el.classList.add('visible'));
  }
</script>
