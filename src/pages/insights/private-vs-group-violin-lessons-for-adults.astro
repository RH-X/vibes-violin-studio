<Layout
  title="Private vs. Group Violin Lessons for Adults | Vibrations Violin Studio"
  description="Private violin lessons or a group class? Explore the benefits, tradeoffs, and learning styles to find the right way to start violin as an adult."
  ogImage="/images/insights/private-vs-group-violin-lessons-for-adults.jpg"
>

  <!-- ── Hero banner ── -->
  <section
    class="hero-interior"
    style="background: linear-gradient(135deg, #b4e7d0 0%, #ddd6fe 100%);"
    aria-labelledby="post-heading"
  >
    <div class="container-narrow">
      <p class="font-heading font-semibold text-xs uppercase tracking-widest text-purplePrimary mb-3" style="letter-spacing: 0.14em;">
        Insights
        <span aria-hidden="true" class="mx-2 font-normal normal-case tracking-normal opacity-50">·</span>
        <time datetime="2026-10-29" class="font-normal normal-case tracking-normal text-ink/50">October 29, 2026</time>
        <span aria-hidden="true" class="mx-2 font-normal normal-case tracking-normal opacity-50">·</span>
        <span class="font-normal normal-case tracking-normal text-ink/50">8 min read</span>
      </p>
      <h1
        id="post-heading"
        class="font-heading font-bold text-ink"
        style="font-size: clamp(2.5rem, 5.5vw, 4.5rem); line-height: 0.95; letter-spacing: -0.045em;"
