  /* Same shape as .btn-primary, in lavender for the dark hero. Dark text on #C9A7F5
     clears AA contrast. */
  :global(.kickstart-cta) {
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    background: #C9A7F5;
    color: #18161B;
    font-family: 'Plus Jakarta Sans', Arial, Helvetica, sans-serif;
