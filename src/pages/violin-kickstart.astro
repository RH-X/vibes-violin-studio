    line-height: 1.65;
    font-weight: 400;
    color: #F1E7DD;
    max-width: 620px;
  }

  .kickstart-trust-strip {
    font-size: 0.86rem;
    letter-spacing: 0.16em;
    font-weight: 700;
    text-transform: uppercase;
    color: #FFF8EC;
    border-top: 1px solid rgba(246, 197, 92, 0.55);
  }

  .kickstart-trust-sep {
    color: rgba(246, 197, 92, 0.55);
  }

  @media (max-width: 640px) {
    .kickstart-hero-card {
      width: calc(100% - 32px);
      padding: 28px;
    }
