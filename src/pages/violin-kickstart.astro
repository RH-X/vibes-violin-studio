---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import InquiryEngine from '../components/InquiryEngine.astro';
import { violinKickstartConfig } from '../lib/inquiries/violin-kickstart';

// ── Launch flag ──
// This page is hidden/prelaunch: not linked from nav/footer/homepage, noindex+nofollow,
// and excluded from the sitemap (see the matching filter in astro.config.mjs).
// To launch: flip this to true, then add a real link to the page somewhere on the
// site, and remove the '/violin-kickstart' exclusion line from the sitemap filter
// in astro.config.mjs.
const VIOLIN_KICKSTART_LAUNCHED = false;

const error = Astro.url.searchParams.get('error');
---

<Layout
  title="Violin Kickstart — A 4-Week Beginner Cohort for Adults | Vibrations Violin Studio"
  description="Join the waitlist for Violin Kickstart, a low-pressure 4-week group cohort for adults curious about starting violin. No instrument needed for the first session."
  noindex={!VIOLIN_KICKSTART_LAUNCHED}
  nofollow={!VIOLIN_KICKSTART_LAUNCHED}
>

  <!-- Hero -->
  <section
    class="hero-interior"
    style="background: linear-gradient(135deg, #fb923c 0%, #c4b5fd 100%);"
    aria-labelledby="kickstart-heading"
  >
    <div class="container-narrow">
      <p class="font-heading font-semibold text-xs uppercase tracking-widest mb-3 text-purplePrimary" style="letter-spacing: 0.14em;">A 4-Week Beginner Cohort for Adults</p>
      <h1 id="kickstart-heading" class="font-heading font-bold text-ink" style="font-size: clamp(2.25rem, 5vw, 4rem); line-height: 0.95; letter-spacing: -0.04em;">
        Violin Kickstart
      </h1>
      <p class="mt-4 text-lg text-ink/70 leading-relaxed max-w-xl">
        A small, low-pressure group for adults who've always been curious about the violin but never quite started. You don't need an instrument for the first session — just curiosity.
      </p>
    </div>
  </section>

  <!-- About section -->
  <section class="section-pad bg-white" aria-labelledby="about-heading">
    <div class="container-narrow">
      <div class="max-w-2xl reveal">
        <p class="font-heading font-semibold text-xs uppercase tracking-widest text-purplePrimary mb-3" style="letter-spacing: 0.14em;">What this is</p>
        <h2 id="about-heading" class="font-heading font-bold text-ink" style="font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.0; letter-spacing: -0.035em;">
          A starting point, not a performance
        </h2>
        <div class="mt-4 space-y-3 text-base text-ink/70 font-light leading-relaxed">
          <p>
            Violin Kickstart is built for total beginners and near-beginners — adults who are curious about violin but want a gentle, structured way in, without pressure or comparison.
          </p>
          <p>
            Over four weeks, in a small group setting, you'll get a real feel for the instrument: how it's held, how sound is made, and whether it's something you want to keep exploring. The first session doesn't require an instrument at all — just show up and see how it feels.
          </p>
          <p>
            This is a waitlist for the next cohort, not an open enrollment. I'll reach out personally as the date comes together.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Waitlist form section -->
  <section id="waitlist" class="section-pad" style="background: #f5f3ff;" aria-labelledby="form-heading">
    <div class="container-narrow">
      <div class="max-w-xl mx-auto">

        <div class="mb-8 reveal">
          <p class="font-heading font-semibold text-xs uppercase tracking-widest text-purplePrimary mb-3" style="letter-spacing: 0.14em;">{violinKickstartConfig.intro.label}</p>
          <h2 id="form-heading" class="font-heading font-bold text-ink" style="font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.0; letter-spacing: -0.035em;">
            {violinKickstartConfig.intro.heading}
          </h2>
          <div class="mt-4 space-y-3 text-base text-ink/70 font-light leading-relaxed">
            {violinKickstartConfig.intro.paragraphs.map((p) => <p>{p}</p>)}
          </div>
        </div>

        <div class="reveal">
          <InquiryEngine config={violinKickstartConfig} error={error} />
        </div>

        <p class="mt-6 text-center text-sm text-ink/50">
          <a href="/" class="text-purplePrimary hover:text-purple-800 transition-colors duration-150">
            ← Back to home
          </a>
        </p>

      </div>
    </div>
  </section>

</Layout>

<script>
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
  } else {
    document.querySelectorAll('.reveal').forEach((el) => el.classList.add('visible'));
  }
</script>
