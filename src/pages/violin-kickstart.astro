    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .kickstart-hero-card {
    opacity: 0;
    animation: kickstartCardIn 700ms cubic-bezier(.16,1,.3,1) 100ms forwards;
