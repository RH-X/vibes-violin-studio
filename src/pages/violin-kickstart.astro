---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import InquiryEngine from '../components/InquiryEngine.astro';
import { violinKickstartConfig } from '../lib/inquiries/violin-kickstart';

// ── Launch flag ──
// This page is hidden/prelaunch: not linked from nav/footer/homepage, noindex+nofollow,
// and excluded from the sitemap (see the matching filter in astro.config.mjs).
// To launch: flip this to true, then add a real link to the page somewhere on the
// site, and remove the '/violin-kickstart' exclusion line from the sitemap filter
// in astro.config.mjs.
const VIOLIN_KICKSTART_LAUNCHED = false;

const error = Astro.url.searchParams.get('error');
---

<Layout
  title="Violin Kickstart — A 4-Week Beginner Cohort for Adults | Vibrations Violin Studio"
  description="Join the waitlist for Violin Kickstart, a low-pressure 4-week group cohort for adults curious about starting violin. No instrument needed for the first session."
  noindex={!VIOLIN_KICKSTART_LAUNCHED}
  nofollow={!VIOLIN_KICKSTART_LAUNCHED}
>

  <!-- Hero -->
  <section
    class="kickstart-hero relative overflow-hidden isolate flex items-center"
    aria-labelledby="kickstart-heading"
  >
    <!-- Background: approved cinematic hero artwork (dark glass composition, violin close-up, gold/purple linework — all baked into the image) -->
    <div
      class="kickstart-hero-bgphoto pointer-events-none absolute inset-0"
      style="background-image: url('/images/violin-kickstart-hero-bg.jpg');"
      aria-hidden="true"
    ></div>

    <div class="container-narrow relative w-full" style="z-index: 2;">
      <div class="kickstart-hero-card">
        <p class="kickstart-eyebrow font-heading">A 4-Week Beginner Cohort for Adults</p>
        <h1 id="kickstart-heading" class="kickstart-heading font-heading">
          Violin Kickstart
        </h1>
        <p class="kickstart-body mt-4">
          A small, low-pressure group for adults who've always been curious about the violin but never quite started. You don't need an instrument for the first session — just curiosity.
        </p>

        <!-- Quiet trust strip — scannable details, no badges -->
        <div class="kickstart-trust-strip font-heading mt-7 pt-6 flex flex-wrap items-center gap-x-3 gap-y-1.5">
          <span>4 Weeks</span>
          <span aria-hidden="true" class="kickstart-trust-sep">·</span>
          <span>Adults</span>
          <span aria-hidden="true" class="kickstart-trust-sep">·</span>
          <span>Beginner-Friendly</span>
          <span aria-hidden="true" class="kickstart-trust-sep">·</span>
          <span>Small Group</span>
          <span aria-hidden="true" class="kickstart-trust-sep">·</span>
          <span>No Instrument Needed for Session One</span>
        </div>
      </div>
    </div>
  </section>

  <!-- About section -->
  <section class="section-pad bg-white" aria-labelledby="about-heading">
    <div class="container-narrow">
      <div class="max-w-2xl reveal">
        <p class="font-heading font-semibold text-xs uppercase tracking-widest text-purplePrimary mb-3" style="letter-spacing: 0.14em;">What this is</p>
        <h2 id="about-heading" class="font-heading font-bold text-ink" style="font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.0; letter-spacing: -0.035em;">
          A starting point, not a performance
        </h2>
        <div class="mt-4 space-y-3 text-base text-ink/70 font-light leading-relaxed">
          <p>
            Violin Kickstart is built for total beginners and near-beginners — adults who are curious about violin but want a gentle, structured way in, without pressure or comparison.
          </p>
          <p>
            Over four weeks, in a small group setting, you'll get a real feel for the instrument: how it's held, how sound is made, and whether it's something you want to keep exploring. The first session doesn't require an instrument at all — just show up and see how it feels.
          </p>
          <p>
            This is a waitlist for the next cohort, not an open enrollment. I'll reach out personally as the date comes together.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Waitlist form section -->
  <section id="waitlist" class="section-pad" style="background: #f5f3ff;" aria-labelledby="form-heading">
    <div class="container-narrow">
      <div class="max-w-3xl mx-auto">

        <div class="mb-8 reveal">
          <p class="font-heading font-semibold text-xs uppercase tracking-widest text-purplePrimary mb-3" style="letter-spacing: 0.14em;">{violinKickstartConfig.intro.label}</p>
          <h2 id="form-heading" class="font-heading font-bold text-ink" style="font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.0; letter-spacing: -0.035em;">
            {violinKickstartConfig.intro.heading}
          </h2>
          <div class="mt-4 space-y-3 text-base text-ink/70 font-light leading-relaxed">
            {violinKickstartConfig.intro.paragraphs.map((p) => <p>{p}</p>)}
          </div>
        </div>

        <div class="reveal">
          <InquiryEngine config={violinKickstartConfig} error={error} />
        </div>

        <p class="mt-6 text-center text-sm text-ink/50">
          <a href="/" class="text-purplePrimary hover:text-purple-800 transition-colors duration-150">
            ← Back to home
          </a>
        </p>

      </div>
    </div>
  </section>

</Layout>

<style>
  /* ── Kickstart hero: cinematic layout shell ── */
  .kickstart-hero {
    min-height: 620px;
    padding: clamp(72px, 8vw, 112px) clamp(24px, 8vw, 96px);
  }

  /* ── Background: approved hero artwork — fades in softly on load ── */
  .kickstart-hero-bgphoto {
    background-position: center center;
    background-size: cover;
    opacity: 0;
    animation: kickstartFadeIn 800ms ease-out forwards;
  }

  /* ── Dark glass hero card ── */
  .kickstart-hero-card {
    width: min(760px, 58vw);
    background: rgba(24, 22, 27, 0.88);
    border: 1px solid rgba(246, 197, 92, 0.55);
    border-radius: 28px;
    padding: clamp(36px, 4vw, 56px);
    box-shadow: 0 28px 80px rgba(24, 14, 10, 0.35);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .kickstart-eyebrow {
    font-size: 0.9rem;
    letter-spacing: 0.18em;
    font-weight: 700;
    text-transform: uppercase;
    color: #C4A5FF;
    margin-bottom: 0.75rem;
  }

  .kickstart-heading {
    font-size: clamp(3.25rem, 6vw, 5.75rem);
    line-height: 0.95;
    font-weight: 800;
    letter-spacing: -0.06em;
    color: #FFF8EC;
  }

  .kickstart-body {
    font-size: clamp(1.125rem, 1.5vw, 1.45rem);
    line-height: 1.65;
    font-weight: 400;
    color: #F1E7DD;
    max-width: 620px;
  }

  .kickstart-trust-strip {
    font-size: 0.86rem;
    letter-spacing: 0.16em;
    font-weight: 700;
    text-transform: uppercase;
    color: #FFF8EC;
    border-top: 1px solid rgba(246, 197, 92, 0.55);
  }

  .kickstart-trust-sep {
    color: rgba(246, 197, 92, 0.55);
  }

  @media (max-width: 640px) {
    .kickstart-hero-card {
      width: calc(100% - 32px);
      padding: 28px;
    }
    .kickstart-heading {
      font-size: clamp(2.6rem, 8vw, 3.2rem);
    }
    .kickstart-body {
      font-size: 1.05rem;
    }
  }

  /* ── Load-in: background overlay fade ── */
  @keyframes kickstartFadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  /* ── Load-in: card fades + translates up 12px ── */
  @keyframes kickstartCardIn {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .kickstart-hero-card {
    opacity: 0;
    animation: kickstartCardIn 700ms cubic-bezier(.16,1,.3,1) 100ms forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .kickstart-hero-bgphoto {
      animation: none;
      opacity: 1;
    }
    .kickstart-hero-card {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  // ── Hero staggered load-in ── card fades/translates via CSS; text stagers in just after ──
  const kickstartHero = document.querySelector('section[aria-labelledby="kickstart-heading"]');
  if (kickstartHero) {
    const card = kickstartHero.querySelector('.kickstart-hero-card');
    const eyebrow = card?.querySelector('.kickstart-eyebrow');
    const heading = card?.querySelector('.kickstart-heading');
    const body = card?.querySelector('.kickstart-body');
    const trustStrip = card?.querySelector('.kickstart-trust-strip');
    ([[eyebrow, 700], [heading, 700], [body, 800], [trustStrip, 900]] as const).forEach(([el, delayMs]) => {
      if (el) {
        el.classList.add('hero-animate');
        (el as HTMLElement).style.animationDelay = `${delayMs}ms`;
      }
    });
  }

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
  } else {
    document.querySelectorAll('.reveal').forEach((el) => el.classList.add('visible'));
  }
</script>
