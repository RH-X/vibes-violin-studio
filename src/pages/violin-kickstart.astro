<script>
  // ── Hero staggered load-in ── card fades/translates via CSS; text stagers in just after ──
  const kickstartHero = document.querySelector('section[aria-labelledby="kickstart-heading"]');
  if (kickstartHero) {
    const card = kickstartHero.querySelector('.kickstart-hero-card');
    const eyebrow = card?.querySelector('.kickstart-eyebrow');
    const heading = card?.querySelector('.kickstart-heading');
    const body = card?.querySelector('.kickstart-body');
    ([[eyebrow, 700], [heading, 700], [body, 800]] as const).forEach(([el, delayMs]) => {
      if (el) {
        el.classList.add('hero-animate');
        (el as HTMLElement).style.animationDelay = `${delayMs}ms`;
      }
    });
  }

  // Choosing an offer's waitlist link preselects that offer in the form.
  document.querySelectorAll<HTMLAnchorElement>('a[data-program]').forEach((link) => {
    link.addEventListener('click', () => {
      const option = document.querySelector<HTMLInputElement>(`input[name="program_interest"][value="${link.dataset.program}"]`);
      if (option) option.checked = true;
    });
  });

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
  } else {
    document.querySelectorAll('.reveal').forEach((el) => el.classList.add('visible'));
  }
</script>
