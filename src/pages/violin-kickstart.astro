---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import InquiryEngine from '../components/InquiryEngine.astro';
import { violinKickstartConfig } from '../lib/inquiries/violin-kickstart';

const VIOLIN_KICKSTART_LAUNCHED = true;

const error = Astro.url.searchParams.get('error');

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteOrigin = Astro.site?.origin ?? 'https://www.vibesviolin.studio';
---

<Layout
  title="Violin Kickstart — A 4-Week Online Cohort for Adult Beginners | Vibrations Violin Studio"
  description="Join the waitlist for Violin Kickstart, a low-pressure 4-week online cohort for adults curious about starting violin, with optional in-person support for local Denver students. No instrument needed for the first session."
  noindex={!VIOLIN_KICKSTART_LAUNCHED}
  nofollow={!VIOLIN_KICKSTART_LAUNCHED}
>

  <!-- Hero -->
  <section
    class="kickstart-hero relative overflow-hidden isolate flex items-center"
    aria-labelledby="kickstart-heading"
  >
    <!-- Background: approved cinematic hero artwork (dark glass composition, violin close-up, gold/purple linework — all baked into the image) -->
    <div
      class="kickstart-hero-bgphoto pointer-events-none absolute inset-0"
      style="background-image: url('/images/violin-kickstart-hero-bg.jpg');"
      aria-hidden="true"
    ></div>

    <div class="container-narrow relative w-full" style="z-index: 2;">
      <div class="kickstart-hero-card">
        <p class="kickstart-eyebrow font-heading">A 4-Week Beginner Cohort for Adults</p>
        <h1 id="kickstart-heading" class="kickstart-heading font-heading">
          Violin Kickstart
        </h1>
        <p class="kickstart-body mt-4">
          Learn violin with guidance, structure, and beginners beside you. Most adults don't stop learning because they aren't musical. Practicing alone can simply feel confusing or overwhelming. The Violin Kickstart is a small, supportive community cohort designed to help you begin with confidence and build a practice habit that can last.
        </p>

        <!-- Quiet trust strip — scannable details, no badges -->
        <div class="kickstart-trust-strip font-heading mt-7 pt-6 flex flex-wrap items-center gap-x-3 gap-y-1.5">
          <span>4 Weeks</span>
          <span aria-hidden="true" class="kickstart-trust-sep">·</span>
          <span>Adults</span>
          <span aria-hidden="true" class="kickstart-trust-sep">·</span>
          <span>Beginner-Friendly</span>
          <span aria-hidden="true" class="kickstart-trust-sep">·</span>
          <span>Small Group</span>
          <span aria-hidden="true" class="kickstart-trust-sep">·</span>
          <span>Online</span>
          <span aria-hidden="true" class="kickstart-trust-sep">·</span>
          <span>No Instrument Needed for Session One</span>
        </div>
      </div>
    </div>
  </section>

  <!-- What's Included section -->
  <section class="section-pad" style="background: #f5f3ff;" aria-labelledby="included-heading">
    <div class="container-narrow">
      <div class="rounded-2xl border border-lavender-200 bg-white p-6 sm:p-8 md:p-10 shadow-sm reveal">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
          <div class="max-w-md">
            <p class="font-heading font-semibold text-xs uppercase tracking-widest text-purplePrimary mb-3" style="letter-spacing: 0.14em;">What's included</p>
            <h2 id="included-heading" class="font-heading font-bold text-ink" style="font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.0; letter-spacing: -0.035em;">
              Support for starting—and continuing.
            </h2>
            <p class="mt-4 text-base text-ink/70 font-light leading-relaxed">
              The founding cohort combines live instruction, individual guidance, and practical support between sessions.
            </p>
          </div>
          <ul class="space-y-4" role="list">
            {[
              "Four live group classes that build confidence week by week",
              "One 30-minute private lesson focused on your individual goals",
              "Weekly personalized feedback so you know what to practice next",
              "Early access to the Practice Pals learning companion",
              "Direct communication with Rae when questions come up",
              "A voice in shaping Practice Pals and future cohorts",
            ].map(item => (
              <li class="flex items-start gap-3 text-base text-ink/70 font-light leading-relaxed">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#6d3fc1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0" aria-hidden="true">
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                  <polyline points="22 4 12 14.01 9 11.01" />
                </svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- About section -->
  <section class="section-pad bg-white" aria-labelledby="about-heading">
    <div class="container-narrow">
      <div class="max-w-2xl reveal">
        <p class="font-heading font-semibold text-xs uppercase tracking-widest text-purplePrimary mb-3" style="letter-spacing: 0.14em;">What this is</p>
        <h2 id="about-heading" class="font-heading font-bold text-ink" style="font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.0; letter-spacing: -0.035em;">
          A starting point, not a performance
        </h2>
        <div class="mt-4 space-y-3 text-base text-ink/70 font-light leading-relaxed">
          <p>
            Violin Kickstart was created for adults who have always wondered what learning violin might be like—but who want a supportive place to begin without pressure, comparison, or the expectation of already knowing what they're doing.
          </p>
          <p>
            Over four weeks, you'll learn how the violin is held, how sound is made, and how to approach practice in manageable steps. Sessions are held live online, with optional in-person support available for local Denver students when applicable. The first session does not require an instrument—you can simply arrive with curiosity and see how it feels.
          </p>
          <p>
            This isn't about becoming a performer in four weeks. It's about discovering whether violin can become something meaningful in your life.
          </p>
          <p>
            <strong class="font-semibold text-ink">You don't need an instrument for the first session—just curiosity.</strong>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Course differentiation section -->
  <section class="section-pad" style="background: #f5f3ff;" aria-labelledby="differentiation-heading">
    <div class="container-narrow">
      <div class="max-w-2xl reveal">
        <p class="font-heading font-semibold text-xs uppercase tracking-widest text-purplePrimary mb-3" style="letter-spacing: 0.14em;">A different kind of beginning</p>
        <h2 id="differentiation-heading" class="font-heading font-bold text-ink" style="font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.0; letter-spacing: -0.035em;">
          Learning how to continue matters, too.
        </h2>
        <p class="mt-4 text-base text-ink/70 font-light leading-relaxed">
          Many beginner courses focus primarily on the notes you will learn. Violin Kickstart also helps you understand how to keep learning after class.
        </p>
        <ul class="mt-4 space-y-2 pl-5 list-none">
          {[
            "Begin with manageable steps.",
            "Learn alongside other adult beginners.",
            "Build confidence before adding complexity.",
            "Create a practice approach that fits real life.",
            "Discover whether violin belongs in your future.",
          ].map(item => (
            <li class="flex items-start gap-3 text-base text-ink/70 font-light leading-relaxed">
              <span class="mt-2 w-1.5 h-1.5 rounded-full bg-purplePrimary opacity-60 shrink-0" aria-hidden="true"></span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Practice Pals founding-participant section -->
  <section class="bg-white section-pad" aria-labelledby="practice-pals-heading">
    <div class="container-narrow">
      <div class="max-w-2xl reveal">
        <p class="font-heading font-semibold text-xs uppercase tracking-widest text-purplePrimary mb-3" style="letter-spacing: 0.14em;">Help shape something new</p>
        <h2 id="practice-pals-heading" class="font-heading font-bold text-ink" style="font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.0; letter-spacing: -0.035em;">
          A better experience between lessons.
        </h2>
        <div class="mt-4 space-y-3 text-base text-ink/70 font-light leading-relaxed">
          <p>
            I've spent more than twenty years teaching violin. One pattern I've seen again and again is that beginners often struggle not because they lack ability, but because practicing between lessons can feel overwhelming.
          </p>
          <p>
            That's why I'm developing <a href="/practice-pals" class="text-purplePrimary underline hover:text-purple-800 transition-colors duration-150">Practice Pals</a>, a teacher-guided practice tool designed to make home practice feel more approachable through short, manageable practice sessions.
          </p>
          <p>
            Members of this first Violin Kickstart cohort will have the opportunity to try an early version and share honest feedback about what helps and what could be clearer.
          </p>
          <p>
            You aren't being asked to become a software expert. You'll be helping shape a better learning experience for future beginners.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Planned timeline section -->
  <section class="section-pad" style="background: #f5f3ff;" aria-labelledby="timeline-heading">
    <div class="container-narrow">
      <div class="max-w-2xl reveal">
        <p class="font-heading font-semibold text-xs uppercase tracking-widest text-purplePrimary mb-3" style="letter-spacing: 0.14em;">Planned timeline</p>
        <h2 id="timeline-heading" class="font-heading font-bold text-ink" style="font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.0; letter-spacing: -0.035em;">
          A four-week beginning this September.
        </h2>
        <p class="mt-4 text-base text-ink/70 font-light leading-relaxed">
          The first Violin Kickstart cohort is planned for mid-September 2026. The exact weekly meeting time will be selected based on the availability of people who join the founding cohort waitlist.
        </p>
        <ul class="mt-4 space-y-2 pl-5 list-none">
          {[
            ["Target start", "Mid-September 2026"],
            ["Format", "Four weekly live online group sessions"],
            ["Session length", "Approximately 60–75 minutes"],
            ["Scheduling", "The final day and time will be chosen to work for the greatest number of founding participants"],
            ["Cohort cost", "$149 for all four sessions, payable only if you enroll once registration opens"],
          ].map(([label, value]) => (
            <li class="flex items-start gap-3 text-base text-ink/70 font-light leading-relaxed">
              <span class="mt-2 w-1.5 h-1.5 rounded-full bg-purplePrimary opacity-60 shrink-0" aria-hidden="true"></span>
              <span><strong class="font-semibold text-ink">{label}:</strong> {value}</span>
            </li>
          ))}
        </ul>
        <p class="mt-4 text-base text-ink/70 font-light leading-relaxed">
          Joining the waitlist helps shape the final schedule, but does not require payment or commit you to enrolling.
        </p>
      </div>
    </div>
  </section>

  <!-- Waitlist form section -->
  <section id="waitlist" class="section-pad bg-white" aria-labelledby="form-heading">
    <div class="container-narrow">
      <div class="max-w-3xl mx-auto">

        <div class="mb-8 reveal">
          <p class="font-heading font-semibold text-xs uppercase tracking-widest text-purplePrimary mb-3" style="letter-spacing: 0.14em;">{violinKickstartConfig.intro.label}</p>
          <h2 id="form-heading" class="font-heading font-bold text-ink" style="font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.0; letter-spacing: -0.035em;">
            {violinKickstartConfig.intro.heading}
          </h2>
          <div class="mt-4 space-y-3 text-base text-ink/70 font-light leading-relaxed">
            {violinKickstartConfig.intro.paragraphs.map((p) => <p>{p}</p>)}
          </div>
        </div>

        <div class="reveal">
          <InquiryEngine config={violinKickstartConfig} error={error} />
        </div>

        <p class="mt-6 text-center text-sm text-ink/50">
          <a href="/" class="text-purplePrimary hover:text-purple-800 transition-colors duration-150">
            ← Back to home
          </a>
        </p>

      </div>
    </div>
  </section>

</Layout>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Course",
  "name": "Violin Kickstart",
  "description": "A 4-week beginner cohort for adults curious about starting violin, held online with optional in-person support for local Denver students. A small, supportive, low-pressure starting point for building confidence and a sustainable practice habit. No instrument needed for the first session.",
  "provider": { "@id": `${siteOrigin}/#business` },
  "url": canonicalURL,
  "offers": {
    "@type": "Offer",
    "price": "149",
    "priceCurrency": "USD",
    "availability": "https://schema.org/PreOrder",
    "url": canonicalURL,
  },
  "hasCourseInstance": {
    "@type": "CourseInstance",
    "courseMode": "blended",
    "courseWorkload": "P4W",
  },
})} />

<style>
  /* ── Kickstart hero: cinematic layout shell ── */
  .kickstart-hero {
    min-height: 620px;
    padding: clamp(72px, 8vw, 112px) clamp(24px, 8vw, 96px);
  }

  /* ── Background: approved hero artwork — fades in softly on load ── */
  .kickstart-hero-bgphoto {
    background-position: center center;
    background-size: cover;
    opacity: 0;
    animation: kickstartFadeIn 800ms ease-out forwards;
  }

  /* ── Dark glass hero card ── */
  .kickstart-hero-card {
    width: min(760px, 58vw);
    background: rgba(24, 22, 27, 0.88);
    border: 1px solid rgba(246, 197, 92, 0.55);
    border-radius: 28px;
    padding: clamp(36px, 4vw, 56px);
    box-shadow: 0 28px 80px rgba(24, 14, 10, 0.35);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .kickstart-eyebrow {
    font-size: 0.9rem;
    letter-spacing: 0.18em;
    font-weight: 700;
    text-transform: uppercase;
    color: #C4A5FF;
    margin-bottom: 0.75rem;
  }

  .kickstart-heading {
    font-size: clamp(3.25rem, 6vw, 5.75rem);
    line-height: 0.95;
    font-weight: 800;
    letter-spacing: -0.06em;
    color: #FFF8EC;
  }

  .kickstart-body {
    font-size: clamp(1.125rem, 1.5vw, 1.45rem);
    line-height: 1.65;
    font-weight: 400;
    color: #F1E7DD;
    max-width: 620px;
  }

  .kickstart-trust-strip {
    font-size: 0.86rem;
    letter-spacing: 0.16em;
    font-weight: 700;
    text-transform: uppercase;
    color: #FFF8EC;
    border-top: 1px solid rgba(246, 197, 92, 0.55);
  }

  .kickstart-trust-sep {
    color: rgba(246, 197, 92, 0.55);
  }

  @media (max-width: 640px) {
    .kickstart-hero-card {
      width: calc(100% - 32px);
      padding: 28px;
    }
    .kickstart-heading {
      font-size: clamp(2.6rem, 8vw, 3.2rem);
    }
    .kickstart-body {
      font-size: 1.05rem;
    }
  }

  /* ── Load-in: background overlay fade ── */
  @keyframes kickstartFadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  /* ── Load-in: card fades + translates up 12px ── */
  @keyframes kickstartCardIn {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .kickstart-hero-card {
    opacity: 0;
    animation: kickstartCardIn 700ms cubic-bezier(.16,1,.3,1) 100ms forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .kickstart-hero-bgphoto {
      animation: none;
      opacity: 1;
    }
    .kickstart-hero-card {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  // ── Hero staggered load-in ── card fades/translates via CSS; text stagers in just after ──
  const kickstartHero = document.querySelector('section[aria-labelledby="kickstart-heading"]');
  if (kickstartHero) {
    const card = kickstartHero.querySelector('.kickstart-hero-card');
    const eyebrow = card?.querySelector('.kickstart-eyebrow');
    const heading = card?.querySelector('.kickstart-heading');
    const body = card?.querySelector('.kickstart-body');
    const trustStrip = card?.querySelector('.kickstart-trust-strip');
    ([[eyebrow, 700], [heading, 700], [body, 800], [trustStrip, 900]] as const).forEach(([el, delayMs]) => {
      if (el) {
        el.classList.add('hero-animate');
        (el as HTMLElement).style.animationDelay = `${delayMs}ms`;
      }
    });
  }

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
  } else {
    document.querySelectorAll('.reveal').forEach((el) => el.classList.add('visible'));
  }
</script>
