---
import Layout from '../layouts/Layout.astro';
import CTABand from '../components/CTABand.astro';
---

<Layout
  title="Practice Pals — Violin Practice Support for Beginners | Vibrations Violin Studio"
  description="Practice Pals is a developing practice support tool for beginner violin students, designed to make at-home practice feel more approachable, personalized, and sustainable."
  noindex={true}
>

  <!-- ── Hero ── -->
  <section
    class="hero-interior"
    style="background: linear-gradient(135deg, #6ee7b7 0%, #c4b5fd 100%);"
    aria-labelledby="practice-pals-heading"
  >
    <div class="container-narrow">
      <p class="font-heading font-semibold text-xs uppercase tracking-widest mb-3" style="letter-spacing: 0.14em; color: #6d3fc1;">Beyond the Lesson</p>
      <h1 id="practice-pals-heading" class="font-heading font-bold text-ink" style="font-size: clamp(2.75rem, 6vw, 5rem); line-height: 0.93; letter-spacing: -0.045em;">
        Practice Pals
      </h1>
      <p class="mt-4 text-lg text-ink/70 leading-relaxed max-w-xl">
        A practice support experiment growing out of real beginner student needs.
      </p>
    </div>
  </section>

  <!-- ── Why I'm Building Practice Pals ── -->
  <section class="bg-white section-pad" aria-labelledby="why-heading">
    <div class="container-narrow">
      <div class="max-w-2xl">
        <p class="font-heading font-semibold text-xs uppercase tracking-widest text-purplePrimary mb-3" style="letter-spacing: 0.14em;">The Idea</p>
        <h2 id="why-heading" class="font-heading font-bold text-ink" style="font-size: clamp(1.75rem, 3.5vw, 2.75rem); line-height: 0.97; letter-spacing: -0.04em;">
          Why I'm Building Practice Pals
        </h2>
        <div class="mt-6 space-y-4 text-base text-ink/70 font-light leading-relaxed">
          <p>
            Over the years, I've noticed that many beginner violin students don't struggle because they lack potential.
          </p>
          <p>
            They struggle because lessons happen once a week, while learning happens between lessons.
          </p>
          <p>
            Practice Pals is an experiment in helping bridge that gap.
          </p>
          <p>
            The goal isn't to replace teachers, create pressure, or turn practice into a game.
          </p>
          <p>
            The goal is to make beginning practice feel a little more approachable, a little more personalized, and a little less overwhelming.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Practice Pals Preview ── -->
  <section class="section-pad" style="background: #f5f3ff;" aria-labelledby="preview-heading">
    <div class="container-narrow">

      <!-- Label + heading -->
      <div class="text-center mb-10">
        <p class="font-heading font-semibold text-xs uppercase tracking-widest text-purplePrimary mb-3" style="letter-spacing: 0.14em;">Practice Pals Preview</p>
        <h2 id="preview-heading" class="font-heading font-bold text-ink" style="font-size: clamp(1.75rem, 3.5vw, 2.75rem); line-height: 0.97; letter-spacing: -0.04em;">
          An Early Concept
        </h2>
        <p class="mt-4 text-base text-ink/70 font-light leading-relaxed mx-auto" style="max-width: 44ch;">
          Exploring how beginner violin students might receive more personalized support between lessons.
        </p>
      </div>

      <!-- Featured image — full container width, generous breathing room -->
      <div class="relative mx-auto" style="max-width: 860px;">
        <!-- Soft lavender blob behind image — depth without noise -->
        <div
          class="pointer-events-none absolute"
          style="
            width: 75%; height: 75%;
            top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            background: #c4b5fd;
            opacity: 0.28;
            border-radius: 48% 52% 44% 56% / 52% 46% 54% 48%;
            filter: blur(48px);
            z-index: 0;
          "
          aria-hidden="true"
        ></div>
        <img
          src="/images/practice-pals-demo.png"
          alt="Practice Pals demo screen showing a practice adventure interface and a friendly puppy buddy for beginner violin students"
          class="relative w-full h-auto rounded-2xl"
          style="z-index: 1; box-shadow: 0 8px 40px rgba(109, 40, 217, 0.10), 0 2px 12px rgba(0,0,0,0.06);"
          width="2983"
          height="2105"
          loading="lazy"
        />
      </div>

    </div>
  </section>

  <!-- ── Squiggle divider ── -->
  <div class="hidden sm:block bg-white" style="padding-top: 2rem; padding-bottom: 0.5rem;" aria-hidden="true">
    <div class="container-narrow" style="position: relative;">
      <svg
        class="pointer-events-none"
        style="width: 80px; height: 48px; transform: rotate(4deg); opacity: 0.28; margin-left: 52%;"
        viewBox="0 0 80 48"
        fill="none"
        stroke="#6d28d9"
        stroke-width="1.5"
        stroke-linecap="round"
        focusable="false"
      >
        <path d="M4 24 C16 6, 28 42, 40 24 C52 6, 64 42, 76 24" />
      </svg>
    </div>
  </div>

  <!-- ── What Makes It Different ── -->
  <section class="bg-white section-pad" aria-labelledby="different-heading">
    <div class="container-narrow">
      <p class="font-heading font-semibold text-xs uppercase tracking-widest text-purplePrimary mb-3" style="letter-spacing: 0.14em;">The Approach</p>
      <h2 id="different-heading" class="font-heading font-bold text-ink" style="font-size: clamp(1.75rem, 3.5vw, 2.75rem); line-height: 0.97; letter-spacing: -0.04em;">
        What Makes It Different
      </h2>
      <p class="mt-4 text-base text-ink/70 font-light leading-relaxed max-w-2xl">
        Most practice tools are built by technologists. Practice Pals grows from the teaching side — from watching real beginners navigate real challenges.
      </p>

      <ul class="mt-10 grid grid-cols-1 sm:grid-cols-3 gap-6" role="list">

        <li class="bg-lavender-50 border border-lavender-200 rounded-lg p-6 flex flex-col gap-4">
          <div>
            <p class="font-heading font-semibold text-ink text-base leading-snug" style="letter-spacing: -0.01em;">Teacher-Guided</p>
            <p class="mt-2 text-sm text-[#3A3140] leading-relaxed">
              Built from real violin teaching experience and designed to support — not replace — the relationship between student and teacher.
            </p>
          </div>
        </li>

        <li class="bg-lavender-50 border border-lavender-200 rounded-lg p-6 flex flex-col gap-4">
          <div>
            <p class="font-heading font-semibold text-ink text-base leading-snug" style="letter-spacing: -0.01em;">Emotionally Grounding</p>
            <p class="mt-2 text-sm text-[#3A3140] leading-relaxed">
              Practice should help students feel more capable, not more pressured. The tool is being designed with flexibility, choice, and low-pressure pacing in mind.
            </p>
          </div>
        </li>

        <li class="bg-lavender-50 border border-lavender-200 rounded-lg p-6 flex flex-col gap-4">
          <div>
            <p class="font-heading font-semibold text-ink text-base leading-snug" style="letter-spacing: -0.01em;">Personalized</p>
            <p class="mt-2 text-sm text-[#3A3140] leading-relaxed">
              The long-term vision is for practice suggestions to adapt based on age, experience level, goals, and student feedback.
            </p>
          </div>
        </li>

      </ul>
    </div>
  </section>

  <!-- ── What It Might Eventually Include ── -->
  <section class="section-pad" style="background: #f5f3ff;" aria-labelledby="features-heading">
    <div class="container-narrow">
      <div class="max-w-2xl">
        <p class="font-heading font-semibold text-xs uppercase tracking-widest text-purplePrimary mb-3" style="letter-spacing: 0.14em;">In Development</p>
        <h2 id="features-heading" class="font-heading font-bold text-ink" style="font-size: clamp(1.75rem, 3.5vw, 2.75rem); line-height: 0.97; letter-spacing: -0.04em;">
          What It Might Eventually Include
        </h2>
        <p class="mt-4 text-base text-ink/70 font-light leading-relaxed">
          Practice Pals is still in active research and development. The specific features are evolving, but the current direction includes ideas like:
        </p>
        <ul class="mt-7 space-y-3" role="list" aria-label="Potential Practice Pals features">
          {[
            "Short guided practice sessions",
            "Personalized activity suggestions",
            "Beginner-friendly daily routines",
            "Listening activities and musical exploration",
            "Practice reflections",
            "Teacher customization tools",
            "Optional timer-free practice support",
            "On-the-go practice ideas for moments without an instrument",
          ].map(item => (
            <li class="flex items-start gap-3 text-base text-ink/70 font-light leading-relaxed">
              <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-purplePrimary opacity-60 shrink-0" aria-hidden="true"></span>
              {item}
            </li>
          ))}
        </ul>
        <p class="mt-7 text-sm text-ink/50 font-light italic">
          These are directions, not promises. The shape of the product will continue to change as it's tested with real students.
        </p>
      </div>
    </div>
  </section>

  <!-- ── Founder Note ── -->
  <section class="bg-white section-pad" aria-labelledby="founder-heading">
    <div class="container-narrow">

      <!-- Pull quote / founder note card -->
      <div class="max-w-3xl mx-auto">
        <blockquote class="border-l-4 border-lavender-300 pl-6 py-1">
          <p class="text-xl sm:text-2xl font-light text-ink leading-relaxed">
            "Practice Pals grows out of real teaching questions, real student experiences, and a curiosity about how technology might support learning without getting in the way of it."
          </p>
        </blockquote>

        <div class="mt-8 text-base text-ink/70 font-light leading-relaxed space-y-4">
          <p>
            As a violin teacher and human-centered designer, Rae is exploring how practice support can feel more adaptive, humane, and sustainable for beginners — especially the ones who find the space between lessons the hardest part.
          </p>
          <p>
            This project is guided by the same values that shape every lesson at Vibrations Violin Studio: consistency over intensity, growth over performance, and the belief that learning should feel safe enough to be honest.
          </p>
        </div>

        <div class="mt-6 flex items-center gap-3">
          <div class="w-8 h-px bg-lavender-300" aria-hidden="true"></div>
          <p class="text-sm font-semibold text-purplePrimary" style="letter-spacing: 0.01em;">Rae McGee, M.M. — Violin Teacher &amp; Studio Founder</p>
        </div>
      </div>

    </div>
  </section>

  <!-- ── Help Shape Practice Pals ── -->
  <section
    class="section-pad"
    style="background: linear-gradient(135deg, #6ee7b7 0%, #c4b5fd 100%);"
    aria-labelledby="feedback-heading"
  >
    <div class="container-narrow">
      <div class="max-w-xl">
        <p class="font-heading font-semibold text-xs uppercase tracking-widest text-purplePrimary mb-3" style="letter-spacing: 0.14em;">Share Your Perspective</p>
        <h2 id="feedback-heading" class="font-heading font-bold text-ink" style="font-size: clamp(1.75rem, 3.5vw, 2.75rem); line-height: 0.97; letter-spacing: -0.04em;">
          Interested in Helping Shape Practice Pals?
        </h2>
        <p class="mt-4 text-base text-ink/70 font-light leading-relaxed">
          Practice Pals is still in the research and development phase. If you're a teacher, parent, adult learner, student, or someone who enjoys thinking about how people learn, I'd love to hear your thoughts.
        </p>
        <p class="mt-3 text-base text-ink/70 font-light leading-relaxed">
          Questions, ideas, frustrations, and early feedback are all welcome.
        </p>
        <div style="display: flex; justify-content: flex-end; width: 100%; margin-top: 2rem;">
          <a
            href="/contact"
            class="btn-primary"
            aria-label="Share your thoughts and help shape the Practice Pals project"
          >
            Help Shape Practice Pals
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<script>
  // ── Practice Pals: scroll-reveal ──
  // Hero: load-in
  const heroSection = document.querySelector('section[aria-labelledby="practice-pals-heading"]');
  if (heroSection) {
    const inner = heroSection.querySelector('.container-narrow');
    if (inner) inner.classList.add('hero-animate', 'hero-delay-1');
  }

  // Body sections: reveal on scroll
  const sections = [
    document.querySelector('section[aria-labelledby="why-heading"]'),
    document.querySelector('section[aria-labelledby="preview-heading"] .container-narrow'),
    document.querySelector('section[aria-labelledby="different-heading"]'),
    document.querySelector('section[aria-labelledby="features-heading"] .container-narrow'),
    document.querySelector('section[aria-labelledby="founder-heading"] .container-narrow'),
    document.querySelector('section[aria-labelledby="feedback-heading"] .container-narrow'),
  ];

  sections.forEach((el, i) => {
    if (el) {
      el.classList.add('reveal');
      (el as HTMLElement).style.transitionDelay = `${i * 40}ms`;
    }
  });

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) { entry.target.classList.add('visible'); observer.unobserve(entry.target); }
      });
    }, { threshold: 0.10 });
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
  }
</script>
