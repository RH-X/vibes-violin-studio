---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import FeaturedIn from '../components/FeaturedIn.astro';
import Highlights from '../components/Highlights.astro';
import Testimonials from '../components/Testimonials.astro';
import StudentCentered from '../components/StudentCentered.astro';
import PracticePals from '../components/PracticePals.astro';
import CTABand from '../components/CTABand.astro';
---

<Layout
  title="Suzuki-Informed Violin Lessons in Denver for Adults & Beginners"
  description="Beginner-friendly violin lessons in Denver for adults and kids. Suzuki-informed, personalized teaching in a calm, encouraging studio."
>
  <Hero />
  <FeaturedIn />
  <Highlights />
  <Testimonials />
  <StudentCentered />

  <!-- Single lavender squiggle — transition cue from About cards into Practice Pals -->
  <div class="relative hidden sm:block" style="height: 0; overflow: visible;" aria-hidden="true">
    <svg
      class="pointer-events-none absolute"
      style="width: 80px; height: 48px; top: -20px; left: 42%; transform: translateX(-50%) rotate(-4deg); opacity: 0.38; z-index: 1;"
      viewBox="0 0 80 48"
      fill="none"
      stroke="#6d28d9"
      stroke-width="1.5"
      stroke-linecap="round"
      focusable="false"
    >
      <path d="M4 24 C16 6, 28 42, 40 24 C52 6, 64 42, 76 24" />
    </svg>
  </div>

  <PracticePals />

  <!-- ── Video CTA Banner ── -->
  <section
    class="relative overflow-hidden"
    style="min-height: 480px;"
    aria-labelledby="video-cta-heading"
  >
    <!-- Background video — muted, autoplay, loop, playsInline -->
    <video
      class="motion-safe:block motion-reduce:hidden absolute inset-0 w-full h-full object-cover"
      style="z-index: 0;"
      autoplay
      muted
      loop
      playsinline
      poster="/images/rae-mktg-site.png"
      aria-hidden="true"
    >
      <source src="/videos/violin-cta-loop.mp4" type="video/mp4" />
    </video>

    <!-- Poster shown for reduced-motion users (video hidden via motion-reduce:hidden above) -->
    <div
      class="motion-safe:hidden motion-reduce:block absolute inset-0 bg-cover bg-center"
      style="background-image: url('/images/rae-mktg-site.png'); z-index: 0;"
      aria-hidden="true"
    ></div>

    <!-- Dark gradient overlay for text legibility -->
    <div
      class="absolute inset-0"
      style="background: linear-gradient(135deg, rgba(30,10,50,0.72) 0%, rgba(60,20,90,0.58) 100%); z-index: 1;"
      aria-hidden="true"
    ></div>

    <!-- Content -->
    <div class="container-narrow relative flex items-center" style="min-height: 480px; z-index: 2;">
      <div class="max-w-xl py-20">
        <p class="text-xs font-semibold uppercase tracking-widest mb-5" style="color: #c4b5fd; letter-spacing: 0.14em;">
          Begin when you're ready
        </p>
        <h2
          id="video-cta-heading"
          class="font-heading font-bold text-white"
          style="font-size: clamp(2rem, 4.5vw, 3.5rem); line-height: 1.0; letter-spacing: -0.04em;"
        >
          Music grows one small step at a time.
        </h2>
        <p class="mt-5 text-base leading-relaxed" style="color: rgba(255,255,255,0.82);">
          Book a friendly intro chat to see whether lessons feel like the right fit.
        </p>
        <a href="/contact" class="btn-primary inline-block mt-8">
          Book an Intro Chat
        </a>
      </div>
    </div>
  </section>

  <CTABand />
</Layout>

<style>
  /* ── Keyframes ── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes blobFloat {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50%      { transform: translateY(-6px) rotate(1deg); }
  }

  /* ── Scroll-reveal base state ── */
  :global(.reveal) {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 600ms cubic-bezier(.16,1,.3,1),
                transform 600ms cubic-bezier(.16,1,.3,1);
  }
  :global(.reveal.visible) {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Hero staggered load-in ── */
  :global(.hero-animate) {
    opacity: 0;
    animation: fadeUp 650ms cubic-bezier(.16,1,.3,1) forwards;
  }
  :global(.hero-delay-1) { animation-delay: 0ms; }
  :global(.hero-delay-2) { animation-delay: 120ms; }
  :global(.hero-delay-3) { animation-delay: 240ms; }

  /* ── Blob ambient float ── */
  :global(.blob-float) {
    animation: blobFloat 16s ease-in-out infinite;
  }

  /* ── Hover: testimonial image card ── */
  :global(section[aria-labelledby="testimonials-heading"] .shadow-card) {
    transition: transform 300ms ease, box-shadow 300ms ease;
  }
  :global(section[aria-labelledby="testimonials-heading"] .shadow-card:hover) {
    transform: scale(1.03);
    box-shadow: 0 12px 32px rgba(0,0,0,.12);
  }

  /* ── Hover: feature cards ── */
  :global(section#approach ul li) {
    transition: transform 300ms ease, box-shadow 300ms ease;
  }
  :global(section#approach ul li:hover) {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0,0,0,.08);
  }

  /* ── Hover: highlight blob cards ── */
  :global(section[aria-label="Studio highlights"] ul li > div) {
    transition: transform 300ms ease;
  }
  :global(section[aria-label="Studio highlights"] ul li > div:hover) {
    transform: scale(1.05);
  }

  /* ── Hover: Practice Pals image ── */
  :global(section[aria-labelledby="practice-pals-heading"] img) {
    transition: transform 300ms ease;
  }
  :global(section[aria-labelledby="practice-pals-heading"] img:hover) {
    transform: scale(1.02);
  }

  /* ── Hover: button lift + shadow ── */
  :global(.btn-primary),
  :global(.btn-secondary) {
    transition: background-color 200ms, color 200ms,
                transform 250ms ease, box-shadow 250ms ease;
  }
  :global(.btn-primary:hover),
  :global(.btn-secondary:hover) {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(0,0,0,.10);
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    :global(.hero-animate) {
      animation: none;
      opacity: 1;
      transform: none;
    }
    :global(.reveal) {
      transition: none;
      opacity: 1;
      transform: none;
    }
    :global(.blob-float) {
      animation: none;
    }
    :global(section[aria-labelledby="testimonials-heading"] .shadow-card),
    :global(section[aria-label="Studio highlights"] ul li > div),
    :global(section#approach ul li),
    :global(section[aria-labelledby="practice-pals-heading"] img),
    :global(.btn-primary),
    :global(.btn-secondary) {
      transition: none;
    }
  }
</style>

<script>
  // ── Hero staggered load-in ──
  const heroSection = document.querySelector('section[aria-labelledby="hero-heading"]');
  if (heroSection) {
    const heading = heroSection.querySelector('#hero-heading');
    const subtitle = heading?.nextElementSibling;
    const buttons = subtitle?.nextElementSibling;
    [heading, subtitle, buttons].forEach((el, i) => {
      if (el) el.classList.add('hero-animate', `hero-delay-${i + 1}`);
    });
  }

  // ── Blob ambient float ──
  document.querySelectorAll(
    'section[aria-labelledby="hero-heading"] .pointer-events-none,' +
    'section[aria-labelledby="cta-heading"] .pointer-events-none'
  ).forEach(blob => blob.classList.add('blob-float'));

  // ── Scroll-reveal stagger helper ──
  const addStagger = (selector, delayStep = 120) => {
    document.querySelectorAll(selector).forEach((el, i) => {
      el.classList.add('reveal');
      el.style.transitionDelay = `${i * delayStep}ms`;
    });
  };

  // Featured-In section
  const featuredIn = document.querySelector('section[aria-label="Press and media features"] .container-narrow > *:last-child');
  if (featuredIn) featuredIn.classList.add('reveal');

  // Highlights badges
  addStagger('section[aria-label="Studio highlights"] ul li', 120);

  // Feature cards
  addStagger('section#approach ul li', 120);

  // Practice Pals — image + text columns
  document.querySelectorAll(
    'section[aria-labelledby="practice-pals-heading"] .grid > div'
  ).forEach((el, i) => {
    el.classList.add('reveal');
    el.style.transitionDelay = `${i * 150}ms`;
  });

  // Lesson rates content
  const ratesContent = document.querySelector(
    'section[aria-labelledby="rates-heading"] .container-narrow'
  );
  if (ratesContent) ratesContent.classList.add('reveal');

  // CTA band content
  const ctaContent = document.querySelector(
    'section[aria-labelledby="cta-heading"] .container-narrow'
  );
  if (ctaContent) ctaContent.classList.add('reveal');

  // ── IntersectionObserver ──
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });

    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
  }
</script>

<!-- deploy trigger -->
