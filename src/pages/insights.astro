---
import Layout from '../layouts/Layout.astro';
import CTABand from '../components/CTABand.astro';
---

<Layout
  title="Insights — Vibrations Violin Studio | Denver, CO"
  description="Tips, practice ideas, and insights for violin students and parents from Rae at Vibrations Violin Studio in Denver, Colorado."
>

  <section
    class="hero-interior"
    style="background: linear-gradient(135deg, #6ee7b7 0%, #c4b5fd 100%);"
    aria-labelledby="insights-heading"
  >
    <div class="container-narrow">
      <p class="font-heading font-semibold text-xs uppercase tracking-widest text-purplePrimary mb-3" style="letter-spacing: 0.14em;">Insights</p>
      <h1 id="insights-heading" class="font-heading font-bold text-ink" style="font-size: clamp(2.75rem, 6vw, 5rem); line-height: 0.93; letter-spacing: -0.045em;">
        Violin Tips &amp; Ideas
      </h1>
      <p class="mt-4 text-lg text-ink/70 leading-relaxed">
        Practice strategies, parent guides, and musical musings from the studio.
      </p>
    </div>
  </section>

  <section class="bg-white section-pad">
    <div class="container-narrow">
      <ul class="space-y-6" role="list">

        <!-- Post: Can You Learn Violin Online? -->
        <li class="bg-lavender-50 border border-lavender-200 rounded-card p-6 sm:p-8">
          <div class="flex flex-wrap items-center gap-3 text-xs text-ink/50 font-light mb-3">
            <span>July 2, 2026</span>
            <span aria-hidden="true">·</span>
            <span>6 min read</span>
          </div>
          <h2 class="font-heading font-bold text-ink leading-snug" style="font-size: clamp(1.25rem, 2.5vw, 1.6rem); letter-spacing: -0.025em;">
            <a
              href="/insights/can-you-learn-violin-online"
              class="hover:text-purplePrimary transition-colors duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purplePrimary rounded"
            >
              Can You Learn Violin Online? What Beginners and Advancing Students Should Know
            </a>
          </h2>
          <p class="mt-3 text-sm text-ink/60 font-light leading-relaxed">
            Can you really learn violin online? Discover how thoughtful virtual lessons help beginners and adults build confidence with personalized guidance.
          </p>
          <a
            href="/insights/can-you-learn-violin-online"
            class="inline-block mt-5 text-sm font-medium text-purplePrimary hover:text-purple-800 transition-colors duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purplePrimary rounded"
            aria-label="Read: Can You Learn Violin Online? What Beginners and Advancing Students Should Know"
          >
            Read article →
          </a>
        </li>

        <!-- Post: The Real Timeline of Learning Violin as an Adult -->
        <li class="bg-lavender-50 border border-lavender-200 rounded-card p-6 sm:p-8">
          <div class="flex flex-wrap items-center gap-3 text-xs text-ink/50 font-light mb-3">
            <span>June 29, 2026</span>
            <span aria-hidden="true">·</span>
            <span>6 min read</span>
          </div>
          <h2 class="font-heading font-bold text-ink leading-snug" style="font-size: clamp(1.25rem, 2.5vw, 1.6rem); letter-spacing: -0.025em;">
            <a
              href="/insights/the-real-timeline-of-learning-violin-as-an-adult"
              class="hover:text-purplePrimary transition-colors duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purplePrimary rounded"
