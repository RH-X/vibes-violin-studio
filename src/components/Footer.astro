---
const year = new Date().getFullYear();
---

<footer class="bg-lavender-50 border-t border-lavender-200" aria-label="Site footer">
  <div class="container-narrow py-12 sm:py-16">

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10 lg:gap-16">

      <!-- Col 1: Contact (most conversion-important, first in DOM order) -->
      <div>
        <p class="font-heading font-semibold text-xs uppercase tracking-widest text-purplePrimary mb-4" style="letter-spacing: 0.14em;">Get in Touch</p>
        <address class="not-italic flex flex-col gap-3">

          <!-- Location -->
          <span class="flex items-start gap-2 text-sm text-[#3A3140]">
            <svg class="mt-0.5 flex-shrink-0 text-mint-500" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            Globeville, Denver, CO
          </span>

          <!-- Phone number + call/text -->
          <div class="flex flex-col gap-1">
            <span class="text-sm text-[#2F2A35] font-medium">(720) 253-0416</span>
            <div class="flex items-center gap-4">
              <a
                href="tel:+17202530416"
                class="flex items-center gap-1.5 text-sm text-[#3A3140] hover:text-purplePrimary transition-colors duration-150"
                aria-label="Call Vibrations Violin Studio"
              >
                <svg class="flex-shrink-0 text-mint-500" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
                Tap to call
              </a>
              <span class="text-ink/20" aria-hidden="true">|</span>
              <a
                href="sms:+17202530416"
                class="flex items-center gap-1.5 text-sm text-[#3A3140] hover:text-purplePrimary transition-colors duration-150"
                aria-label="Text Vibrations Violin Studio"
              >
                <svg class="flex-shrink-0 text-mint-500" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
                </svg>
                Tap to text
              </a>
            </div>
          </div>

          <!-- Email -->
          <button
            class="copy-email flex items-center gap-2 text-sm text-[#3A3140] hover:text-purplePrimary transition-colors duration-150 cursor-pointer bg-transparent border-none p-0"
            data-copy="vibesviolinstudio@gmail.com"
            type="button"
            aria-label="Copy email address to clipboard"
          >
            <svg class="flex-shrink-0 text-mint-500" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <span class="copy-email-text">vibesviolinstudio@gmail.com</span>
          </button>

        </address>
      </div>

      <!-- Col 2: Studio info (SEO/GEO) -->
      <div>
        <p class="font-heading font-semibold text-xs uppercase tracking-widest text-purplePrimary mb-4" style="letter-spacing: 0.14em;">About the Studio</p>
        <p class="text-sm text-[#3A3140] leading-relaxed">
          Private violin lessons in Denver, Colorado, taught from my studio in the Globeville neighborhood of central Denver.
        </p>
        <p class="mt-3 text-xs text-[#3A3140] leading-relaxed">
          Online lessons available worldwide. Convenient for students across Denver, including Wash Park, Capitol Hill, Cherry Creek, and the Highlands.
        </p>
      </div>

      <!-- Col 3: Navigation + logo -->
      <div>
        <p class="font-heading font-semibold text-xs uppercase tracking-widest text-purplePrimary mb-4" style="letter-spacing: 0.14em;">Navigation</p>
        <nav aria-label="Footer navigation">
          <ul class="flex flex-col gap-2">
            {[
              { label: 'About', href: '/about' },
              { label: 'FAQ', href: '/faq' },
              { label: 'Insights', href: '/insights' },
              { label: 'Practice Pals', href: '/practice-pals' },
              { label: 'Contact', href: '/contact' },
            ].map(({ label, href }) => (
              <li>
                <a
                  href={href}
                  class="text-sm text-[#3A3140] hover:text-purplePrimary transition-colors duration-150"
                >
                  {label}
                </a>
              </li>
            ))}
            <li>
              <a
                href="https://www.google.com/maps/place/Vibrations+Violin+Studio/@39.7637782,-105.184397,106113m/data=!3m2!1e3!4b1!4m6!3m5!1s0x876c7ff7ec8c4473:0x7211bc2c2fc447b4!8m2!3d39.7642444!4d-104.8547524!16s%2Fg%2F11ll2m56k5?entry=ttu"
                class="text-sm text-[#3A3140] hover:text-purplePrimary transition-colors duration-150"
                target="_blank"
                rel="noopener noreferrer"
              >
                Read Reviews on Google ↗
              </a>
            </li>
          </ul>
        </nav>

        <!-- Logo: brand accent -->
        <img
          src="/images/logos/vibrations-logo.jpg"
          alt="Vibrations Violin Studio"
          class="h-28 w-auto mt-8"
          width="2048"
          height="1582"
          loading="lazy"
        />
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="mt-10 pt-6 border-t border-lavender-200 flex flex-col sm:flex-row items-center justify-between gap-2">
      <p class="text-xs text-[#4a4050]">
        &copy; {year} Vibrations Violin Studio &mdash; Denver, CO
      </p>
      <p class="text-xs text-[#5a5060]">
        Private violin lessons for all ages &amp; levels.
      </p>
    </div>

  </div>
</footer>

<script>
  document.querySelectorAll('.copy-email').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const email = btn.getAttribute('data-copy');
      if (!email) return;
      const textEl = btn.querySelector('.copy-email-text') || btn;
      const original = textEl.textContent;
      let success = false;
      try {
        await navigator.clipboard.writeText(email);
        success = true;
      } catch {
        // Fallback for non-secure contexts
        try {
          const ta = document.createElement('textarea');
          ta.value = email;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          document.body.removeChild(ta);
          success = true;
        } catch { /* ignore */ }
      }
      if (success) {
        textEl.textContent = '✓ Copied!';
        textEl.classList.add('text-green-600');
      } else {
        textEl.textContent = 'Copy failed';
        textEl.classList.add('text-red-500');
      }
      setTimeout(() => {
        textEl.textContent = original;
        textEl.classList.remove('text-green-600', 'text-red-500');
      }, 2000);
    });
  });
</script>
