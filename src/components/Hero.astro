---
---

<section
  class="relative w-full overflow-hidden isolate"
  style="background: linear-gradient(150deg, #fdf6ee 0%, #ede9fe 55%, #ddd6fe 100%); min-height: clamp(620px, calc(100vh - 120px), 720px);"
  aria-labelledby="hero-heading"
>

  <!-- ── Aurora blob layer — sits behind all content ── -->

  <!-- Blob 1: lavender glow — large, upper-left, brand anchor -->
  <div
    class="aurora-blob pointer-events-none absolute rounded-full"
    style="
      width: 800px; height: 800px;
      top: -260px; left: -200px;
      background: radial-gradient(circle, #a78bfa 0%, #c4b5fd 45%, transparent 72%);
      opacity: 0.55;
      filter: blur(72px);
      z-index: 1;

      animation: auroraA 14s ease-in-out infinite alternate;
    "
    aria-hidden="true"
  ></div>

  <!-- Blob 2: warm mint — lower-right, keeps energy and life -->
  <div
    class="aurora-blob pointer-events-none absolute rounded-full"
    style="
      width: 580px; height: 580px;
      bottom: -160px; right: -120px;
      background: radial-gradient(circle, #6ee7b7 0%, #a7f3d0 50%, transparent 75%);
      opacity: 0.50;
      filter: blur(64px);
      z-index: 1;

      animation: auroraB 18s ease-in-out infinite alternate;
    "
    aria-hidden="true"
  ></div>

  <!-- Blob 3: soft warm cream accent — center-left, adds depth and warmth -->
  <div
    class="aurora-blob pointer-events-none absolute rounded-full"
    style="
      width: 420px; height: 420px;
      top: 30%; left: 10%;
      background: radial-gradient(circle, #fde68a 0%, #fef3c7 50%, transparent 75%);
      opacity: 0.30;
      filter: blur(80px);
      z-index: 1;

      animation: auroraC 22s ease-in-out infinite alternate;
    "
    aria-hidden="true"
  ></div>

  <!-- ── Hero content (z-2, above all blobs) ── -->
  <div
    class="relative container-narrow flex items-center"
    style="padding-top: clamp(3rem, 5vw, 5rem); padding-bottom: clamp(3rem, 5vw, 5rem); z-index: 2;"
  >

    <!-- Two-column grid: text left, image right -->
    <div
      class="w-full grid grid-cols-1 lg:grid-cols-[1fr_auto] items-center"
      style="gap: clamp(1.5rem, 3vw, 3.5rem);"
    >

      <!-- ── Left: copy block ── -->
      <div class="text-center lg:text-left max-w-xl lg:max-w-none">

        <h1
          id="hero-heading"
          class="font-heading font-bold text-ink"
          style="font-size: clamp(2.2rem, 5vw, 4.25rem); line-height: 0.92; letter-spacing: -0.045em; text-wrap: balance;"
        >
          Violin Lessons That Build<br />
          <span class="text-purplePrimary">Musicianship, Confidence,<br class="hidden sm:inline" /> and Joy</span>
        </h1>

        <p class="text-lg sm:text-xl leading-relaxed font-medium" style="margin-top: 1.125rem; color: #2F2A35;">
          with Rae McGee, M.M.
        </p>

        <p class="text-base leading-relaxed mx-auto lg:mx-0 max-w-[38rem]" style="margin-top: 1rem; color: #3A3140;">
          I started violin at 12 through my public school music program. That experience showed me how much the right teacher can shape a student's musical journey.
        </p>

        <p class="text-base leading-relaxed mx-auto lg:mx-0 max-w-[38rem]" style="margin-top: 0.75rem; color: #3A3140; font-style: italic;">
          My goal is to create lessons that feel encouraging, challenging, and meaningful.
        </p>

        <div
          class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4"
          style="margin-top: 2.25rem;"
        >
          <a href="/contact" class="btn-secondary text-base px-8 py-3.5">
            Get Started
          </a>
          <a href="#approach" class="btn-primary text-base px-8 py-3.5">
            Learn More
          </a>
        </div>
      </div>

      <!-- ── Right: editorial image composition ── -->
      <div
        class="hero-image-art-wrapper relative isolate flex items-center justify-center lg:justify-end mt-4 lg:mt-0 mx-auto lg:mx-0"
        style="width: min(36vw, 380px); min-width: 240px;"
      >

        <!-- Trailing lavender blob — offset bottom-left -->
        <div
          class="pointer-events-none absolute"
          style="
            width: 88%;
            height: 88%;
            bottom: -6%;
            left: -8%;
            background: #c4b5fd;
            opacity: 0.50;
            border-radius: 45% 55% 58% 42% / 48% 42% 58% 52%;
            z-index: 1;
          "
          aria-hidden="true"
        ></div>

        <!-- Student photo with organic blob mask -->
        <img
          src="/images/testimonials/testimonial-student.jpg"
          alt="A young violin student proudly holding up a hand-drawn picture of a violin"
          class="relative w-full h-auto"
          style="
            z-index: 2;
            object-fit: contain;
            object-position: center center;
            border-radius: 44% 56% 38% 62% / 52% 38% 62% 48%;
            display: block;
          "
          width="1297"
          height="1729"
          loading="eager"
        />

      </div>
      <!-- /image art -->

    </div>
  </div>
</section>

<style>
  /* ── Aurora blob animations — each drifts on its own diagonal path ── */

  @keyframes auroraA {
    from { transform: translate(0px,   0px)  scale(1);    }
    to   { transform: translate(140px, 100px) scale(1.18); }
  }

  @keyframes auroraB {
    from { transform: translate(0px,   0px)   scale(1);    }
    to   { transform: translate(-120px, -90px) scale(1.22); }
  }

  @keyframes auroraC {
    from { transform: translate(0px,   0px) scale(1)    rotate(0deg); }
    to   { transform: translate(-80px, 60px) scale(1.15) rotate(8deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .aurora-blob {
      animation: none !important;
    }
  }
</style>
