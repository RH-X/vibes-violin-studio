---
---

<section
  class="border-y border-lavender-200 bg-lavender-50"
  aria-label="Press and media features"
>
  <div class="container-narrow py-8 sm:py-10">

    <!-- Eyebrow -->
    <p class="text-xs font-semibold uppercase tracking-widest text-purplePrimary mb-5 text-center sm:text-left">
      Featured In
    </p>

    <!-- Editorial card: photo | text | logo+cta -->
    <div class="flex flex-col sm:flex-row sm:items-stretch gap-0 border border-lavender-200 rounded-card overflow-hidden bg-white">

      <!-- Left: Rae's photo -->
      <div class="sm:w-32 shrink-0">
        <img
          src="/images/rae-mktg-site.png"
          alt="Rae McGee, violin instructor and founder of Vibrations Violin Studio"
          width="1242"
          height="1746"
          class="w-full h-40 sm:h-full object-cover object-top"
          loading="lazy"
        />
      </div>

      <!-- Vertical divider (desktop) -->
      <div class="hidden sm:block w-px bg-lavender-200 shrink-0" aria-hidden="true"></div>

      <!-- Center: editorial text -->
      <div class="flex-1 flex flex-col justify-center px-6 py-5">
        <p class="text-xs font-semibold uppercase tracking-widest text-purplePrimary mb-1.5">Voyage Denver</p>
        <p class="text-base sm:text-lg font-light text-ink leading-snug mb-1.5">
          A Conversation About Teaching, Music &amp; Mission
        </p>
        <p class="text-xs sm:text-sm text-ink/60 font-light leading-relaxed mb-4">
          An interview about my journey, teaching philosophy, and life as a musician.
        </p>
        <div>
          <a
            href="https://voyagedenver.com/interview/daily-inspiration-meet-rae-mcgee"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary text-xs px-4 py-2"
            aria-label="Read the VoyageDenver interview with Rae McGee (opens in new tab)"
          >
            Read the Feature
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline-block ml-1.5 -mt-0.5" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>

      <!-- Vertical divider (desktop) -->
      <div class="hidden sm:block w-px bg-lavender-200 shrink-0" aria-hidden="true"></div>

      <!-- Right: VoyageDenver logo -->
      <div class="shrink-0 sm:w-40 flex flex-col items-center justify-center px-6 py-5 gap-1.5">
        <div class="bg-ink rounded-xl px-4 py-2.5 inline-flex items-center justify-center">
          <img
            src="/images/voyage-denver-logo.png"
            alt="VoyageDenver Magazine"
            width="592"
            height="87"
            class="h-7 w-auto max-w-none"
            loading="lazy"
          />
        </div>
        <p class="text-xs text-ink/40 font-light uppercase tracking-widest text-center">Magazine</p>
      </div>

    </div>
  </div>
</section>
