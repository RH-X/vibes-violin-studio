---
const recognitionItems = [
  {
    type: "logo",
    href: "https://voyagedenver.com/interview/daily-inspiration-meet-rae-mcgee",
    ariaLabel: "Read the interview feature on VoyageDenver (opens in new tab)",
    src: "/images/voyage-denver-logo.png",
    alt: "VoyageDenver Magazine logo",
    width: 592,
    height: 87,
    imgClass: "h-6 sm:h-7 w-auto",
    pill: true,
    caption: "Magazine",
  },
  {
    type: "logo",
    href: "https://www.colo-asta.org/find-a-teacher",
    ariaLabel: "Colorado ASTA teacher directory listing for Rae McGee (opens in new tab)",
    src: "/images/social-proof/colorado-asta-logo.png",
    alt: "Colorado ASTA — American String Teachers Association logo",
    width: 224,
    height: 80,
    imgClass: "h-11 sm:h-14 w-auto",
    pill: false,
    caption: "Listed Teacher",
  },
  {
    type: "logo",
    href: null,
    ariaLabel: null,
    src: "/images/social-proof/university-of-denver-logo.png",
    alt: "University of Denver logo",
    width: 498,
    height: 162,
    imgClass: "h-8 sm:h-9 w-auto",
    pill: false,
    caption: "Alumni Spotlight",
  },
];
---

<section
  class="border-y border-lavender-200 bg-lavender-50"
  aria-label="Press and media features"
>
  <div class="container-narrow py-10 sm:py-16">

    <div class="flex flex-col sm:flex-row sm:items-center gap-8 sm:gap-0">

      <!-- Col 1 (~40%): editorial photo -->
      <div class="shrink-0 w-full sm:w-[38%] sm:pr-10">
        <img
          src="/images/rae-mktg-site.png"
          alt="Rae McGee holding a violin"
          width="1242"
          height="1746"
          class="w-full h-72 sm:h-80 object-cover object-top rounded-sm"
          loading="lazy"
        />
      </div>

      <!-- Col 2 (~40%): press copy -->
      <div class="flex-1 sm:px-10">
        <p class="font-heading font-semibold text-xs uppercase tracking-widest text-purplePrimary mb-4" style="letter-spacing: 0.14em;">
          Featured In
        </p>
        <h2 class="font-heading font-bold text-ink mb-4" style="font-size: clamp(2rem, 4vw, 3rem); line-height: 0.95; letter-spacing: -0.04em;">
          Voyage Denver Magazine
        </h2>
        <p class="text-base text-ink leading-relaxed mb-6 max-w-sm">
          An interview about my journey, teaching philosophy, and life as a musician.
        </p>
        <a
          href="https://voyagedenver.com/interview/daily-inspiration-meet-rae-mcgee"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-2 text-sm font-medium text-purplePrimary underline underline-offset-4 decoration-lavender-400 hover:text-purple-800 hover:decoration-purple-800 transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purplePrimary"
          aria-label="Read the interview feature on VoyageDenver (opens in new tab)"
        >
          <span class="inline-block transition-transform duration-200 group-hover:translate-x-1">Read the Feature</span>
          <span class="inline-block transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </span>
        </a>
      </div>

      <!-- Mobile-only recognition strip: below sm, the column-3 logos are
           hidden, so this auto-scrolling marquee surfaces all three
           recognition items without stacking them vertically and pushing
           the page copy down. Duplicated track for a seamless loop; the
           duplicate is aria-hidden with its links removed from tab order.
           prefers-reduced-motion swaps it for a static, manually
           scrollable strip. -->
      <div class="sm:hidden -mx-1 featured-in-marquee">
        <div class="featured-in-marquee__track">
          {[0, 1].map((copy) => (
            <div class="flex items-center gap-8 px-1" aria-hidden={copy === 1 ? "true" : undefined}>
              {recognitionItems.map((item) => (
                <div class="flex flex-col items-center gap-2 shrink-0">
                  {item.pill ? (
                    <div class="bg-ink rounded-xl px-4 py-3 inline-flex items-center justify-center">
                      <a
                        href={item.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={item.ariaLabel}
                        tabindex={copy === 1 ? -1 : undefined}
                      >
                        <img
                          src={item.src}
                          alt={item.alt}
                          width={item.width}
                          height={item.height}
                          class={item.imgClass}
                          loading="lazy"
                        />
                      </a>
                    </div>
                  ) : item.href ? (
                    <a
                      href={item.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={item.ariaLabel}
                      tabindex={copy === 1 ? -1 : undefined}
                      class="px-4 py-3 inline-flex items-center justify-center rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purplePrimary"
                    >
                      <img
                        src={item.src}
                        alt={item.alt}
                        width={item.width}
                        height={item.height}
                        class={item.imgClass}
                        loading="lazy"
                      />
                    </a>
                  ) : (
                    <div class="px-4 py-3 inline-flex items-center justify-center">
                      <img
                        src={item.src}
                        alt={item.alt}
                        width={item.width}
                        height={item.height}
                        class={item.imgClass}
                        loading="lazy"
                      />
                    </div>
                  )}
                  <p class="text-[11px] text-ink/60 font-light uppercase tracking-widest whitespace-nowrap">{item.caption}</p>
                </div>
              ))}
            </div>
          ))}
        </div>
      </div>

    </div>

    <!-- Recognition row (desktop): a single clean horizontal row below the
         photo/copy, centered and evenly spaced with thin dividers, instead
         of the old vertical stack squeezed into a narrow side column.
         Mobile keeps the auto-scroll marquee above. -->
    <div class="hidden sm:flex items-center justify-center gap-10 mt-12 pt-10 border-t border-lavender-200">
      <div class="flex flex-col items-center gap-2">
        <div class="bg-ink rounded-xl px-4 py-3 inline-flex items-center justify-center">
          <a
            href="https://voyagedenver.com/interview/daily-inspiration-meet-rae-mcgee"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Read the interview feature on VoyageDenver (opens in new tab)"
          >
            <img
              src="/images/voyage-denver-logo.png"
              alt="VoyageDenver Magazine logo"
              width="592"
              height="87"
              class="h-7 w-auto"
              loading="lazy"
            />
          </a>
        </div>
        <p class="text-xs text-ink/60 font-light uppercase tracking-widest">Magazine</p>
      </div>

      <div class="w-px h-14 bg-lavender-200 shrink-0" aria-hidden="true"></div>

      <!-- Colorado ASTA: no dark pill here — the source logo already sits on
           its own white background, so a second dark box would double up
           as a mismatched white-on-black rectangle. Matching px-4/py-3
           keeps the same spacing rhythm as the VoyageDenver mark above. -->
      <div class="flex flex-col items-center gap-2">
        <a
          href="https://www.colo-asta.org/find-a-teacher"
          target="_blank"
          rel="noopener noreferrer"
          class="group px-4 py-3 inline-flex items-center justify-center rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purplePrimary"
          aria-label="Colorado ASTA teacher directory listing for Rae McGee (opens in new tab)"
        >
          <img
            src="/images/social-proof/colorado-asta-logo.png"
            alt="Colorado ASTA — American String Teachers Association logo"
            width="224"
            height="80"
            class="h-14 w-auto transition-transform duration-500 group-hover:scale-[1.06]"
            loading="lazy"
          />
        </a>
        <p class="text-xs text-ink/60 font-light uppercase tracking-widest">Listed Teacher</p>
      </div>

      <div class="w-px h-14 bg-lavender-200 shrink-0" aria-hidden="true"></div>

      <!-- University of Denver: logo sits on its own white background
           like the ASTA mark, so no dark pill here either. Not a link —
           this is a spotlight feature, not an endorsement with a
           citable source URL. -->
      <div class="flex flex-col items-center gap-2">
        <div class="px-4 py-3 inline-flex items-center justify-center">
          <img
            src="/images/social-proof/university-of-denver-logo.png"
            alt="University of Denver logo"
            width="498"
            height="162"
            class="h-9 w-auto"
            loading="lazy"
          />
        </div>
        <p class="text-xs text-ink/60 font-light uppercase tracking-widest">Alumni Spotlight</p>
      </div>
    </div>

  </div>

  <style>
    .featured-in-marquee {
      overflow: hidden;
      -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
      mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    }

    .featured-in-marquee__track {
      display: flex;
      width: max-content;
      animation: featured-in-scroll 16s linear infinite;
    }

    .featured-in-marquee:hover .featured-in-marquee__track,
    .featured-in-marquee:focus-within .featured-in-marquee__track {
      animation-play-state: paused;
    }

    @keyframes featured-in-scroll {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }

    @media (prefers-reduced-motion: reduce) {
      .featured-in-marquee {
        overflow-x: auto;
        -webkit-mask-image: none;
        mask-image: none;
      }
      .featured-in-marquee__track {
        animation: none;
      }
      .featured-in-marquee__track > div[aria-hidden="true"] {
        display: none;
      }
    }
  </style>
</section>
