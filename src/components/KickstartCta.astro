---
// Join the Waitlist link for the January campaign. `location` and `program` feed the
// kickstart_waitlist_cta_click listener in Layout.astro, and `program` also preselects
// that offer in the form. `href` defaults to the on-page form; pages other than
// /violin-kickstart pass the full path.
interface Props {
  location: string;
  program?: string;
  label?: string;
  ariaLabel?: string;
  class?: string;
  href?: string;
}

const { location, program, label = 'Join the Waitlist', ariaLabel, class: className = 'btn-primary', href = '#waitlist' } = Astro.props;
---

<a
  href={href}
  class={`inline-flex items-center gap-2 ${className}`}
  data-kickstart-cta={location}
  data-program={program}
  aria-label={ariaLabel}
>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" />
    <path d="M13.73 21a2 2 0 0 1-3.46 0" />
  </svg>
  <span>{label}</span>
</a>
