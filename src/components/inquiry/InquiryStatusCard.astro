---
import Layout from '../../layouts/Layout.astro';
import type { InquiryConfig } from '../../lib/inquiry/types';
import { INQUIRY_EVENTS } from '../../lib/inquiry/analytics-events';

type Kind = 'pending' | 'success' | 'invalid' | 'expired' | 'already';

interface Props {
  config: InquiryConfig;
  kind: Kind;
}

const { config, kind } = Astro.props;

const copy: Record<Kind, { label: string; heading: string; body: string; iconColor: string }> = {
  pending: {
    label: 'Almost there',
    heading: 'Check your inbox',
    body: config.successMessage ?? 'A verification email is on its way. Click the link inside to confirm your email address.',
    iconColor: '#6d28d9',
  },
  success: {
    label: "You're in",
    heading: 'Email confirmed',
    body: `Thanks for confirming your email. Your ${config.title.toLowerCase()} has been sent.`,
    iconColor: '#059669',
  },
  invalid: {
    label: "Something's off",
    heading: "That link isn't valid",
    body: "This link doesn't match, has already been used, or the URL is incomplete.",
    iconColor: '#dc2626',
  },
  expired: {
    label: 'Link expired',
    heading: 'That link has expired',
    body: 'Verification links expire after 48 hours for your security. Please submit again to get a fresh one.',
    iconColor: '#dc2626',
  },
  already: {
    label: 'Already confirmed',
    heading: "You're already confirmed",
    body: 'This email address has already been verified — no further action needed.',
    iconColor: '#059669',
  },
};

const { label, heading, body, iconColor } = copy[kind];
---

<Layout title={`${heading} | ${config.title}`} description={body} noindex={true}>
  <section
    class="hero-interior"
    style="background: linear-gradient(135deg, #6ee7b7 0%, #c4b5fd 100%);"
    aria-labelledby="status-heading"
  >
    <div class="container-narrow">
      <p class="font-heading font-semibold text-xs uppercase tracking-widest mb-3 text-purplePrimary" style="letter-spacing: 0.14em;">{label}</p>
      <h1 id="status-heading" class="font-heading font-bold text-ink" style="font-size: clamp(2.25rem, 5vw, 4rem); line-height: 0.95; letter-spacing: -0.04em;">
        {heading}
      </h1>
    </div>
  </section>

  <section class="section-pad" style="background: #f5f3ff;">
    <div class="container-narrow">
      <div class="max-w-xl mx-auto rounded-2xl border border-lavender-200 bg-white p-8 shadow-sm text-center">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke={iconColor} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mx-auto mb-4" aria-hidden="true">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
          <polyline points="22 4 12 14.01 9 11.01" />
        </svg>
        <p class="text-base leading-relaxed" style="color: #3A3140;">{body}</p>
        <p class="mt-6 text-sm">
          <a href={config.backHref ?? '/'} class="text-purplePrimary hover:text-purple-800 transition-colors duration-150">← Back</a>
        </p>
      </div>
    </div>
  </section>
</Layout>

{(kind === 'pending' || kind === 'success') && (
  <script define:vars={{ kind, slug: config.slug, events: INQUIRY_EVENTS }}>
    if (typeof window.gtag === 'function') {
      if (kind === 'pending') {
        window.gtag('event', events.verificationEmailSent, { inquiry_slug: slug });
      } else if (kind === 'success') {
        window.gtag('event', events.verificationCompleted, { inquiry_slug: slug });
        window.gtag('event', events.submitted, { inquiry_slug: slug });
      }
    }
  </script>
)}
