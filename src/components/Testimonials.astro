---
---

<section
  class="section-pad relative overflow-hidden"
  style="background-color: #ede9fe;"
  aria-labelledby="testimonials-heading"
>

  <!-- Soft ambient blob behind the panel -->
  <div
    class="pointer-events-none absolute"
    style="
      width: 55%;
      height: 70%;
      top: -10%;
      right: -8%;
      background: #c4b5fd;
      opacity: 0.32;
      border-radius: 58% 42% 62% 38% / 44% 56% 44% 56%;
      filter: blur(48px);
    "
    aria-hidden="true"
  ></div>

  <!-- Sketched squiggle accent — lower left -->
  <svg
    class="pointer-events-none absolute"
    style="width: 90px; height: 60px; bottom: 24px; left: 20px; opacity: 0.5;"
    viewBox="0 0 90 55"
    fill="none"
    stroke="#3b1f6e"
    stroke-width="1.6"
    stroke-linecap="round"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M4 28 C16 8, 28 48, 40 28 C52 8, 64 48, 76 28 C81 18, 86 34, 88 26" />
    <path d="M4 40 C16 20, 28 60, 40 40 C52 20, 64 60, 76 40" stroke-width="1.1" opacity="0.5"/>
  </svg>

  <!-- Sketched squiggle accent — right side -->
  <svg
    class="pointer-events-none absolute hidden lg:block"
    style="width: 60px; height: 60px; top: 30%; right: 18px; opacity: 0.35; transform: rotate(90deg);"
    viewBox="0 0 60 60"
    fill="none"
    stroke="#3b1f6e"
    stroke-width="1.6"
    stroke-linecap="round"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M4 30 C14 10, 24 50, 34 30 C44 10, 54 50, 58 30" />
  </svg>

  <div class="container-narrow relative">

    <!-- Centered quote panel -->
    <div
      class="relative mx-auto max-w-4xl"
      style="
        background: rgba(255,255,255,0.72);
        backdrop-filter: blur(8px);
        border-radius: 28% 72% 22% 78% / 8% 8% 92% 92%;
        padding: clamp(2.5rem, 6vw, 4rem) clamp(2rem, 6vw, 4.5rem);
        box-shadow: 0 4px 32px rgba(91,33,182,0.07);
      "
    >

      <!-- Decorative opening quote mark -->
      <span
        class="pointer-events-none absolute"
        style="
          top: -0.25rem;
          left: clamp(1.5rem, 4vw, 3rem);
          font-family: 'Plus Jakarta Sans', Arial, sans-serif;
          font-size: clamp(6rem, 12vw, 10rem);
          font-weight: 800;
          line-height: 1;
          color: #c4b5fd;
          opacity: 0.55;
          user-select: none;
          pointer-events: none;
        "
        aria-hidden="true"
      >"</span>

      <!-- Tiny spark accent — upper right -->
      <svg
        class="pointer-events-none absolute"
        style="width: 22px; height: 22px; top: 1.5rem; right: 2rem; opacity: 0.5; color: #7c3aed;"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        aria-hidden="true"
        focusable="false"
      >
        <line x1="12" y1="2" x2="12" y2="8"/>
        <line x1="12" y1="16" x2="12" y2="22"/>
        <line x1="2" y1="12" x2="8" y2="12"/>
        <line x1="16" y1="12" x2="22" y2="12"/>
        <line x1="4.93" y1="4.93" x2="7.76" y2="7.76"/>
        <line x1="16.24" y1="16.24" x2="19.07" y2="19.07"/>
        <line x1="19.07" y1="4.93" x2="16.24" y2="7.76"/>
        <line x1="7.76" y1="16.24" x2="4.93" y2="19.07"/>
      </svg>

      <!-- Stars -->
      <div class="flex items-center gap-1 mb-6 relative z-10" aria-label="5 out of 5 stars">
        {Array.from({ length: 5 }).map(() => (
          <svg class="text-yellow-400" width="22" height="22" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
        ))}
      </div>

      <!-- Quote -->
      <blockquote class="relative z-10" style="font-family: 'IBM Plex Sans', Arial, sans-serif;">
        <p
          class="text-ink/85"
          style="font-size: clamp(1.15rem, 2vw, 1.6rem); line-height: 1.55; letter-spacing: 0; font-style: italic; font-weight: 400;"
        >
          "My kids, aged 6 and 3, had a really wonderful experience with violin here. I was impressed with how the lessons were tailored to their abilities, their interests, and also whatever energy and behavior they were bringing with them that day ;) it's also a very approachable entry point to violin, in general. Other Suzuki programs felt a little overwhelming to me in terms of the commitment, especially when I wasn't sure how the kids would take to it. This experience felt relaxed and yet meaningful and supportive of this early learning and exposure."
        </p>
      </blockquote>

      <!-- Reviewer name + Google link row -->
      <div class="relative z-10 mt-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <cite
          class="not-italic font-semibold text-ink/70"
          style="font-family: 'IBM Plex Sans', Arial, sans-serif; font-size: 0.975rem;"
        >
          — Aya Takemoto
        </cite>

        <a
          href="https://www.google.com/maps/place/Vibrations+Violin+Studio/@39.7637782,-105.184397,106113m/data=!3m2!1e3!4b1!4m6!3m5!1s0x876c7ff7ec8c4473:0x7211bc2c2fc447b4!8m2!3d39.7642444!4d-104.8547524!16s%2Fg%2F11ll2m56k5?entry=ttu"
          class="group inline-flex items-center gap-2 text-sm font-semibold text-purplePrimary underline underline-offset-4 decoration-lavender-400 hover:text-purple-800 hover:decoration-purple-800 transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purplePrimary"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Read more reviews on Google (opens in new tab)"
        >
          <span class="inline-block transition-transform duration-200 group-hover:translate-x-1">Read More Reviews on Google</span>
          <span class="inline-block transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </span>
        </a>
      </div>

      <!-- Decorative closing quote mark -->
      <span
        class="pointer-events-none absolute"
        style="
          bottom: -2.5rem;
          right: clamp(1.5rem, 4vw, 3rem);
          font-family: 'Plus Jakarta Sans', Arial, sans-serif;
          font-size: clamp(6rem, 12vw, 10rem);
          font-weight: 800;
          line-height: 1;
          color: #c4b5fd;
          opacity: 0.35;
          user-select: none;
          pointer-events: none;
        "
        aria-hidden="true"
      >"</span>

    </div>
    <!-- /quote panel -->

    <!-- Carousel dots (visual only) -->
    <div class="mt-14 flex justify-center gap-2" aria-hidden="true">
      <span class="w-3 h-3 rounded-full bg-purplePrimary"></span>
      <span class="w-3 h-3 rounded-full bg-lavender-300"></span>
    </div>

  </div>
</section>
