---
---

<section
  class="bg-lavender-50 section-pad"
  aria-labelledby="rates-banner-heading"
>
  <div class="container-narrow">
    <div class="grid grid-cols-1 sm:grid-cols-[1fr_auto] gap-8 items-center">

      <!-- Left: text + CTA -->
      <div>
        <p class="font-heading font-semibold text-xs uppercase tracking-widest text-purplePrimary mb-3" style="letter-spacing: 0.14em;">Lesson Options</p>
        <h2
          id="rates-banner-heading"
          class="font-heading font-bold text-ink"
          style="font-size: clamp(2rem, 4vw, 3.25rem); line-height: 0.96; letter-spacing: -0.04em;"
        >
          Find the pace that works for you.
        </h2>
        <p class="mt-4 text-base text-[#3A3140] leading-relaxed max-w-md">
          Choose a lesson length that supports your goals, attention span, stage of learning, and budget.
        </p>
        <a href="/about#rates" class="btn-primary inline-block mt-8">View Rates</a>
      </div>

      <!-- Right: image panel (hidden on mobile) -->
      <div class="hidden sm:block w-52 h-52 lg:w-60 lg:h-60 rounded-2xl overflow-hidden shadow-lg flex-shrink-0">
        <img
          src="/images/rates-banner.jpg"
          alt=""
          class="w-full h-full object-cover"
          aria-hidden="true"
          loading="lazy"
          width="240"
          height="240"
        />
      </div>

    </div>
  </div>
</section>
