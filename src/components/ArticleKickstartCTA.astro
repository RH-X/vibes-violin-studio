---
// Violin Kickstart card for Insights articles. Dates, times and offers come from
// src/lib/kickstart.ts so they never drift from the Kickstart page. The button reuses
// KickstartCta, so clicks feed the existing kickstart_waitlist_cta_click listener.
import KickstartCta from './KickstartCta.astro';
import { KICKSTART_OFFERS, KICKSTART_START_LABEL, KICKSTART_TIME_LABEL } from '../lib/kickstart';

interface Props {
  location?: string;
}

const { location = 'article_kickstart' } = Astro.props;
---

<aside
  class="mt-8 rounded-card border border-purplePrimary/30 bg-gradient-to-br from-lavender-100 to-mint-100 p-5 sm:p-7"
  aria-label="Violin Kickstart, January 2027"
>
  <p class="text-xs font-semibold uppercase tracking-wider text-purplePrimary">
    Live online · Starts {KICKSTART_START_LABEL}
  </p>
  <p class="mt-2 font-heading text-xl font-bold text-ink">Violin Kickstart: a guided start for adult beginners</p>

  <ul class="mt-5 grid gap-3 sm:grid-cols-2">
    {KICKSTART_OFFERS.map((offer) => (
      <li class="rounded-lg bg-white/80 p-4">
        <p class="font-heading font-semibold text-ink">{offer.name}</p>
        <p class="mt-1 text-sm text-ink/70">{offer.frequency}, {offer.schedule}</p>
      </li>
    ))}
  </ul>
  <p class="mt-3 text-sm text-ink/70">Four weeks, {KICKSTART_TIME_LABEL}. No experience needed.</p>

  <div class="mt-6 flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:gap-6">
    <KickstartCta href="/violin-kickstart#waitlist" location={location} />
    <a
      href="/insights/what-to-expect-violin-kickstart"
      class="font-semibold text-purplePrimary underline hover:text-purple-800 transition-colors duration-150"
    >
      See what the four weeks look like
    </a>
  </div>
</aside>
